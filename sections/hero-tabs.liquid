{{ 'component-subscription.css' | asset_url | stylesheet_tag }}
{{ 'section-hero.css' | asset_url | stylesheet_tag }}

{% render 'anchor', anchor_id: section.settings.anchor_id %}

<style>
    .tab_{{ section.id }}{
        display: none;
    }
    .{{ section.id }}_active_tab {
        display: block !important;
    }
    .menu_{{ section.id }}{
        display: flex;
        justify-content: space-evenly;
        flex-wrap: wrap;
    }
    .active_{{ section.id }}{
        background-color: {{ section.settings.button_color }} !important;
        color: {{ section.settings.button_text_color }} !important;
    }

    .tabs_{{ section.id }}{
        padding-bottom: 3rem;
    }

    .tabs_{{ section.id }} .button{
        padding: 0rem 7rem;
    }

    .tabs_{{ section.id }} .hero__title{
        margin-bottom: 5rem;
    }
    .tabs_{{ section.id }} .hero__outer{
        box-shadow: #cdcdcd .5rem .5rem 1.5rem;
        animation: smooth-appear 1s ease;
    }
    @keyframes smooth-appear {
        from{
            box-shadow: #cdcdcd 0rem 0rem 0rem;
        }
        to{
            box-shadow: #cdcdcd .5rem .5rem 1.5rem;
        }
    }
</style>

<div class="container pt-5 pb-5">
    <div class="section-text">
        {% render 'section-text', section: section, class: 'herotabs', text_align: section.settings.text_align %}
    </div>

    <div class="tabs_{{ section.id }}">
        {% for block in section.blocks %}
            <div id="{{ section.id }}tab{{ forloop.index }}" class="tab_{{ section.id }} {% if forloop.index == 1 %} {{ section.id }}_active_tab{% endif %}">

                {% comment %}
                    hero starts
                {% endcomment %}

                {%- liquid
                    assign image_ratio = block.settings.image_ratio
                -%}

                {%- if image_ratio == 'adapt' and block.settings.image != blank -%}
                    {% assign padding_bottom = 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | round: 2 %}
                    {% style %}
                        #Hero-{{ block.id }} .hero__image-inner::before {
                            content: '';
                            display: block;
                            padding-bottom: {{ padding_bottom }}%;
                        }

                        #Hero-{{ block.id }} .hero__outer--overlay::before {
                            content: '';
                            display: block;
                            padding-bottom: {{ padding_bottom }}%;
                        }
                    {% endstyle %}
                {%- elsif image_ratio == 'adapt' and block.settings.video != blank -%}
                    {% assign padding_bottom = 1 | divided_by: block.settings.video.aspect_ratio | times: 100 | round: 2 %}
                    <style>
                        #Hero-{{ block.id }} .hero__image-inner::before {
                            content: '';
                            display: block;
                            padding-bottom: {{ padding_bottom }}%;
                        }

                        #Hero-{{ block.id }} .hero__outer--overlay::before {
                            content: '';
                            display: block;
                            padding-bottom: {{ padding_bottom }}%;
                        }
                    </style>
                {% else %}
                    {% liquid
                        assign aspect_ratio = block.settings.image_ratio | split: '/'
                        assign temp = aspect_ratio[0] | append: '.0'
                        assign padding_bottom = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
                    %}
                    {% style %}
                        #Hero-{{ block.id }} .hero__image-inner::before {
                            content: '';
                            display: block;
                            padding-bottom: {{ padding_bottom }}%;
                        }

                        #Hero-{{ block.id }} .hero__outer--overlay::before {
                            content: '';
                            display: block;
                            padding-bottom: {{ padding_bottom }}%;
                        }
                    {% endstyle %}
                {%- endif -%}

                {% if block.settings.overlay_opacity == 0 %}
                    {% style %}
                        [data-scheme="dark"] {
                            #Hero-{{ block.id }} .hero__overlay {
                                opacity: 0.4;
                            }
                        }

                        @media (prefers-color-scheme: dark) {
                            [data-scheme="auto"] {
                                #Hero-{{ block.id }} .hero__overlay {
                                opacity: 0.4;
                                }
                            }
                        }
                    {% endstyle %}
                {% endif %}

                {% if block.settings.icon_size != 0 %}
                    {% style %}
                        .tabs_{{ section.id }} .hero__icon_{{ block.id }}{
                            padding-bottom:2rem;
                        }
                        .tabs_{{ section.id }} .hero__icon_{{ block.id }} i{
                            font-size:{{ block.settings.icon_size }}px;
                        }
                    {% endstyle %}
                {% endif %}

                <div id="Hero-{{ block.id }}" class="hero section-{{ block.id }}-padding {% if block.settings.layout == 'overlay' and block.settings.header_overlay %} section--has-overlay {% if block.settings.header_transparent %} section--header-light {% endif %} {% endif %}">
                        <div class="hero__outer hero__outer--{{ block.settings.layout }} {% if block.settings.layout == 'overlay' %}color-{{ block.settings.color_scheme }}{% endif %} {% if block.settings.layout == 'horizontal' %}hero__outer--{{ block.settings.block_type }}{% endif %}
                            {% if block.settings.desktop_image_position == 'before' %}hero__outer--desktop-order{% endif %}
                            {% if block.settings.mobile_image_position == 'before' %}hero__outer--mobile-order{% endif %}
                            {% if block.settings.layout == 'overlay' %}hero__outer--mobile-image-{{ block.settings.mobile_image_overlay }} {% endif %}">

                            <div class="hero__content {% if block.settings.layout == 'overlay' %}container{% endif %}
                              {% if block.settings.layout == 'horizontal' or block.settings.layout == 'overlay' %}hero__content--{{ block.settings.vertical_alignment }}{% endif %}
                              {% if block.settings.layout == 'vertical' or block.settings.layout == 'overlay' %}hero__content--{{ block.settings.horizontal_alignment }}{% endif %}">


                                {% comment %} Icon {% endcomment %}
                                {% if block.settings.icon != 'none' %}
                                    <div class="hero__icon_{{ block.id }}" {{ block.shopify_attributes }}>
                                            <i class="icon icon-pack icon-{{ block.settings.icon }}"></i>
                                    </div>
                                {% endif %}


                                {% comment %} sub heading {% endcomment %}
                                {% if block.settings.subheading != blank %}
                                    <{{ block.settings.subheading_tag }} class="hero__subtitle {{ block.settings.subheading_style }}" {{ block.shopify_attributes }}>
                                        {% if block.settings.subheading_icon != 'none' %}
                                            <i class="icon icon-pack icon-{{ block.settings.subheading_icon }}"></i>
                                        {% endif %}
                                        {{ block.settings.subheading }}
                                    </{{ block.settings.subheading_tag }}>
                                {% endif %}

                                {% comment %} heading {% endcomment %}
                                {% if block.settings.heading != blank %}
                                    <{{ block.settings.heading_tag }} class="hero__title title {{ block.settings.heading_size }} hero__title--{{ block.settings.heading_line }}
                                          title--{{ block.settings.heading_line }} js-anim-{{ block.settings.heading_animation }}
                                          {% if block.settings.word_break and block.settings.heading_line != 'none' %} hero__title--word_break {% endif %}
                                          {% if block.settings.word_break_an and block.settings.heading_animation != 'none' %} hero__title--word_break_an {% endif %}"
                                            data-content="{{ block.settings.heading | escape }}"
                                            {{ block.shopify_attributes }}
                                            style="--color-line: {{ block.settings.line_color }}">
                                    {{ block.settings.heading }}
                                    </{{ block.settings.heading_tag }}>
                                {% endif %}

                                {% comment %} description {% endcomment %}
                                {% if block.settings.description != blank %}
                                    <div class="hero__description description" {{ block.shopify_attributes }}>
                                        {{ block.settings.description }}
                                    </div>
                                {% endif %}

                                {% comment %} subscription {% endcomment %}
                                {% if block.settings.subscription_button_label != blank %}
                                    <div class="hero__subscription-wrapper" {{ block.shopify_attributes }}>
                                        {% render 'subscription',
                                                label: block.settings.subscription_button_label,
                                                style: block.settings.subscription_button_style,
                                                color_scheme: block.settings.color_scheme_subscribe,
                                                enable_box_shadow: block.settings.enable_box_shadow,
                                                class: 'hero'
                                        %}
                                    </div>
                                {% endif %}

                                {% comment %} buttons {% endcomment %}
                                <div class="hero__buttons" {{ block.shopify_attributes }}>
                                    {% if block.settings.show_button_1 != blank %}
                                        {% render 'button',
              block_id: block.id,
              section_id: section.id,
                                                link: block.settings.button_link_1,
                                                label: block.settings.button_label_1,
                                                style: block.settings.button_style_1
                                        %}
                                    {% endif %}
                                    {% if block.settings.show_button_2 != blank %}
                                        {% render 'button',
              block_id: block.id,
              section_id: section.id,
                                                link: block.settings.button_link_2,
                                                label: block.settings.button_label_2,
                                                style: block.settings.button_style_2
                                        %}
                                    {% endif %}
                                </div>

                                {% comment %} caption {% endcomment %}
                                {% if block.settings.show_caption_1 or block.settings.show_caption_2 or block.settings.show_caption_3 %}
                                    <div class="hero__captions" {{ block.shopify_attributes }}>
                                        {% if block.settings.show_caption_1 %}
                                            <div class="hero__captions-item">
                                                {% if block.settings.caption_icon_1 != 'none' %}
                                                    <i class="icon icon-pack icon-{{ block.settings.caption_icon_1 }}"></i>
                                                {% endif %}
                                                <span class="body-small">{{ block.settings.caption_text_1 }}</span>
                                            </div>
                                        {% endif %}
                                        {% if block.settings.show_caption_2 %}
                                            <div class="hero__captions-item">
                                                {% if block.settings.caption_icon_2 != 'none' %}
                                                    <i class="icon icon-pack icon-{{ block.settings.caption_icon_2 }}"></i>
                                                {% endif %}
                                                <span class="body-small">{{ block.settings.caption_text_2 }}</span>
                                            </div>
                                        {% endif %}
                                        {% if block.settings.show_caption_3 %}
                                            <div class="hero__captions-item">
                                                {% if block.settings.caption_icon_3 != 'none' %}
                                                    <i class="icon icon-pack icon-{{ block.settings.caption_icon_3 }}"></i>
                                                {% endif %}
                                                <span class="body-small">{{ block.settings.caption_text_3 }}</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endif %}

                                <div class="hero__users" {{ block.shopify_attributes }}>
                                    {% if block.settings.user_image_1 != blank %}
                                        <div class="hero__users-image">
                                            {{
                                            block.settings.user_image_1
                                            | image_url: width: block.settings.user_image_1.width
                                            | image_tag: loading: '', widths: '70, 140'
                                            }}
                                        </div>
                                    {% endif %}

                                    {% if block.settings.user_image_2 != blank %}
                                        <div class="hero__users-image">
                                            {{
                                            block.settings.user_image_2
                                            | image_url: width: block.settings.user_image_2.width
                                            | image_tag: loading: '', widths: '70, 140'
                                            }}
                                        </div>
                                    {% endif %}

                                    {% if block.settings.user_image_3 != blank %}
                                        <div class="hero__users-image">
                                            {{
                                            block.settings.user_image_3
                                            | image_url: width: block.settings.user_image_3.width
                                            | image_tag: loading: '', widths: '70, 140'
                                            }}
                                        </div>
                                    {% endif %}

                                    {% if block.settings.user_image_4 != blank %}
                                        <div class="hero__users-image">
                                            {{
                                            block.settings.user_image_4
                                            | image_url: width: block.settings.user_image_4.width
                                            | image_tag: loading: '', widths: '70, 140'
                                            }}
                                        </div>
                                    {% endif %}

                                    {% if block.settings.user_image_5 != blank %}
                                        <div class="hero__users-image">
                                            {{
                                            block.settings.user_image_5
                                            | image_url: width: block.settings.user_image_5.width
                                            | image_tag: loading: '', widths: '70, 140'
                                            }}
                                        </div>
                                    {% endif %}

                                    {% if block.settings.user_text != blank %}
                                        <span class="body-small">{{ block.settings.user_text }}</span>
                                    {% endif %}
                                </div>
                            </div>

                            {% if block.settings.video != blank %}
                                <div class="hero__image">
                                    <div class="hero__image-inner hero__image-inner--{{ block.settings.object_fit }}">
                                        {% if block.settings.layout == 'overlay' %}
                                            <span class="hero__overlay"
                                                  style="--overlay-opacity: {{ block.settings.overlay_opacity }};"></span>
                                        {% endif %}
                                        {%- capture style -%}object-fit: {{ block.settings.object_fit }};{%- endcapture -%}
                                        {{
                                        block.settings.video
                                        | video_tag: image_size: '1920x', autoplay: true, loop: true, muted: true, controls: false, style: style
                                        }}
                                    </div>
                                </div>
                            {% elsif block.settings.image != blank %}
                                <div class="hero__image">
                                    <div class="hero__image-inner">
                                        {% if block.settings.layout == 'overlay' %}
                                            <span class="hero__overlay"
                                                  style="--overlay-opacity: {{ block.settings.overlay_opacity }};"></span>
                                        {% endif %}

                                        {% liquid
                                            assign width_ratio = 1
                                            if image_ratio != 'adapt'
                                                assign aspect_ratio_img = block.settings.image.aspect_ratio | round: 2
                                                assign aspect_ratio_settings = aspect_ratio[0] | plus: 0.0 | divided_by: aspect_ratio[1] | round: 2

                                                if aspect_ratio_img > aspect_ratio_settings
                                                    assign width_ratio = aspect_ratio_img | divided_by: aspect_ratio_settings | round: 2
                                                endif
                                            endif

                                            if block.settings.image.width > block.settings.image.height
                                                assign width_adapt_ratio = 320 | times: block.settings.image.aspect_ratio | round: 2
                                            endif
                                        %}

                                        {% capture sizes %}
                                            {% if block.settings.layout == 'horizontal' %}
                                                (min-width: 1200px) calc((40vw - 40px) * {{ width_ratio }}),
                                                (min-width: 990px) calc((50vw - 40px) * {{ width_ratio }}),
                                            {% else %}
                                                (min-width: 990px) calc((100vw - 40px) * {{ width_ratio }}),
                                            {% endif %}
                                            {% if block.settings.image.width > block.settings.image.height %}
                                                {{ width_adapt_ratio }}px
                                            {% else %}
                                                calc((100vw - 40px) * {{ width_ratio }})
                                            {% endif %}
                                        {% endcapture %}

                                        {% liquid
                                            assign height = block.settings.image.height
                                            assign width = block.settings.image.width
                                        %}

                                        {%- capture style -%}object-fit: {{ block.settings.object_fit }};{%- endcapture -%}

                                        {{
                                        block.settings.image
                                        | image_url: width: block.settings.image.width
                                        | image_tag:
                                        loading: '',
                                        sizes: sizes,
                                        widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3264, 3400, 3584, 3800, 4000, 4200, 4400, 4600, 4800, 5000, 5200, 5400, 5600',
                                        height: height,
                                        width: width,
                                        style: style
                                        }}
                                    </div>
                                </div>

                            {% else %}
                                <div class="hero__image">
                                    <div class="hero__image-inner hero__image-inner--{{ block.settings.object_fit }}">
                                        {% if block.settings.layout == 'overlay' %}
                                            <span class="hero__overlay"
                                                  style="--overlay-opacity: {{ block.settings.overlay_opacity }};"></span>
                                        {% endif %}
                                        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                </div>

                {% comment %}
                    hero ends
                {% endcomment %}

            </div>
        {% endfor %}
    </div>

    <div id="menu" class="menu_{{ section.id }}">
        {% for block in section.blocks %}
            <a class="button button--style {% if forloop.index == 1 %} active_{{ section.id }}{% endif %}" data-id="#{{ section.id }}tab{{ forloop.index }}">
                {{ block.settings.button_text }}
            </a>
       {% endfor %}
    </div>
</div>

<script>
    (() => {
        function registerEventListeners() {
            const menus = document.querySelectorAll('.menu_{{ section.id }} a');
            const tabs = document.querySelectorAll('.tab_{{ section.id }}');
            if (menus) menus.forEach(button => {
                button.addEventListener("click",function () {

                    // reset tabs and buttons
                    menus.forEach(button_inset => {
                       if(button_inset.classList.contains("active_{{ section.id }}"))
                           button_inset.classList.remove("active_{{ section.id }}")
                    });
                    tabs.forEach(tab =>{
                       if(tab.classList.contains("{{ section.id }}_active_tab"))
                           tab.classList.remove('{{ section.id }}_active_tab')
                    });

                    // activate button and tab
                    const tab_id = button.dataset.id;
                    const tab = document.querySelector(tab_id);
                    if(tab && !tab.classList.contains("{{ section.id }}_active_tab"))
                        tab.classList.add("{{ section.id }}_active_tab")

                    if(!button.classList.contains("active_{{ section.id }}"))
                        button.classList.add("active_{{ section.id }}");

                })
            })
        }

        document.addEventListener('DOMContentLoaded', registerEventListeners);
        document.addEventListener('shopify:section:load', registerEventListeners);
    })();
</script>

{% schema %}
{
  "name": "Hero tabs",
  "tag": "section",
  "class": "section-hero-tabs spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Heading",
      "label": "t:sections.all.heading.label",
      "info": "t:sections.all.heading.info"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "p", "label": "p" },
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" },
        { "value": "h5", "label": "h5" },
        { "value": "h6", "label": "h6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_line",
      "options": [
        {
          "value": "simple",
          "label": "t:sections.all.heading_line.options__1.label"
        },
        {
          "value": "rounded",
          "label": "t:sections.all.heading_line.options__2.label"
        },
        {
          "value": "background",
          "label": "t:sections.all.heading_line.options__3.label"
        },
        {
          "value": "none",
          "label": "t:sections.all.heading_line.options__4.label"
        }
      ],
      "default": "simple",
      "label": "t:sections.all.heading_line.label"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "t:sections.all.line_color.label",
      "default": "#1566E0"
    },
    {
      "type": "checkbox",
      "id": "word_break",
      "label": "t:sections.all.word_break.label",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_animation",
      "options": [
        {
          "value": "typewriter",
          "label": "t:sections.all.heading_animation.options__1.label"
        },
        {
          "value": "rolling",
          "label": "t:sections.all.heading_animation.options__2.label"
        },
        {
          "value": "appearing",
          "label": "t:sections.all.heading_animation.options__3.label"
        },
        {
          "value": "none",
          "label": "t:sections.all.heading_animation.options__4.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.heading_animation.label",
      "info": "t:sections.all.heading_animation.info"
    },
    {
      "type": "checkbox",
      "id": "word_break_an",
      "label": "t:sections.all.word_break_an.label",
      "default": false
    },
    {
      "type": "textarea",
      "id": "text",
      "default": "Some description",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:sections.all.text_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.text_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_align.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color (on active)",
      "default": "#d8f6ff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color (on active)",
      "default": "#14486f"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "default": "Button",
          "label": "Button text"
        },
        {
          "type": "select",
          "id": "layout",
          "options": [
            {
              "value": "horizontal",
              "label": "t:sections.hero.settings.layout.options__1.label"
            },
            {
              "value": "vertical",
              "label": "t:sections.hero.settings.layout.options__2.label"
            },
            {
              "value": "overlay",
              "label": "t:sections.hero.settings.layout.options__3.label"
            }
          ],
          "default": "horizontal",
          "label": "t:sections.hero.settings.layout.label"
        },
        {
          "type": "checkbox",
          "id": "header_overlay",
          "default": false,
          "label": "t:sections.all.header_overlay.label",
          "info": "t:sections.hero.settings.header_overlay.info"
        },
        {
          "type": "checkbox",
          "id": "header_transparent",
          "label": "t:sections.all.header_transparent.label",
          "info": "t:sections.all.header_transparent.info",
          "default": false
        },
        {
          "type": "select",
          "id": "block_type",
          "options": [
            {
              "value": "plain",
              "label": "t:sections.hero.settings.block_type.options__1.label"
            },
            {
              "value": "subtle",
              "label": "t:sections.hero.settings.block_type.options__2.label"
            }
          ],
          "default": "subtle",
          "label": "t:sections.hero.settings.block_type.label",
          "info": "t:sections.hero.settings.block_type.info"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "default": "background-3",
          "label": "t:sections.all.color_scheme.label",
          "info": "t:sections.hero.settings.color_scheme.info"
        },
        {
          "type": "header",
          "content": "t:sections.hero.settings.header__1.content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image.label"
        },
        {
          "type": "checkbox",
          "id": "show_video",
          "label": "t:sections.all.video.show_video.label",
          "default": false
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.all.video.video.label"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 1,
          "step": 0.1,
          "default": 0.5,
          "label": "t:sections.all.overlay_opacity.label",
          "info": "t:sections.hero.settings.overlay_opacity.info"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "options": [
            {
              "value": "1/1",
              "label": "t:sections.image-banner.settings.image_ratio.options__1.label"
            },
            {
              "value": "2/1",
              "label": "t:sections.image-banner.settings.image_ratio.options__2.label"
            },
