                                </div>
                                <div class="testimonials__rating-count body-small">
                                    {{ block.settings.rating | append: '.00' }}
                                </div>
                            </div>
                        {% endif %}
                        {% if block.settings.enable_badge and block.settings.badge_text != blank %}
