{{ 'section-testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'testimonials.js' | asset_url }}" defer="defer"></script>

{% render 'anchor', anchor_id: section.settings.anchor_id %}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

{% liquid
  if section.settings.slide_text_size == 'recommended'
    case section.settings.layout
      when 'simple_slider', 'marquee'
        assign text_size = 'h6'
      when 'full_slider'
        assign text_size = 'h3'
      when 'image_left_slider'
        assign text_size = 'h4'
      else
        assign text_size = 'h5'
    endcase
  endif
%}

<div class="testimonials color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding testimonials--{{ section.settings.layout }}">
  <div class="container">
    {% render 'section-text', section: section, class: 'testimonials', text_align: section.settings.text_align %}

    <div class="testimonials__content content">
      {% liquid
        if section.settings.layout == 'simple_slider' or section.settings.layout == 'image_top_slider'
          assign columns = 3
        else
          assign columns = 1
        endif

        if section.settings.layout == 'full_slider'
          assign content_align = 'center'
        else
          assign content_align = 'left'
        endif
      %}

      {% if section.settings.layout != 'marquee' %}
        {% assign navigation = false %}
        {% if section.settings.enable_navigation or section.settings.enable_navigation_mobile %}
          {% assign navigation = true %}
        {% endif %}
        {% assign pagination = false %}
        {% if section.settings.enable_pagination or section.settings.enable_pagination_mobile %}
          {% assign pagination = true %}
        {% endif %}
        <div class="testimonials__slider-wrapper">
          <div
            class="
              testimonials__slider swiper
              testimonials__slider--{{ section.settings.layout }}
              testimonials__slider--columns-{{ columns }}
            "
            data-columns="{{ columns }}"
            data-navigation="{{ navigation }}"
            data-pagination="{{ pagination }}"
          >
            <div class="testimonials__wrapper swiper-wrapper">
              {%- for block in section.blocks -%}
                <div class="swiper-slide">
                  <div
                    class="testimonials__slide testimonials__slide--{{ content_align }} color-{{ section.settings.slide_color_scheme }}"
                    {{ block.shopify_attributes }}
                  >
                    {% if section.settings.layout == 'image_left_slider'
                      or section.settings.layout == 'image_top_slider'
                    %}
                      {% if block.settings.image != blank %}
                        {% capture sizes %}
                          (min-width: 750px) 550px, 
                          calc(100vw - 40px)
                        {% endcapture %}
                        <div class="testimonials__author-image">
                          {{
                            block.settings.image
                            | image_url: width: block.settings.image.width
                            | image_tag:
                              loading: '',
                              class: 'motion-reduce media--second',
                              widths: '360, 533, 720, 940, 1066, 1200',
                              sizes: sizes
                          }}
                        </div>
                      {% endif %}
                    {% endif %}

                    <div class="testimonials__item">
                    {% if block.settings.enable_rating %}
                      <div class="testimonials__rating">
                        <div class="testimonials__stars count-stars-{{ block.settings.rating }}">
                          <i class="icon-star"></i>
                        </div>
                        <div class="testimonials__rating-count body-small">
                          {{ block.settings.rating | append: '.00' }}
                        </div>
                      </div>
                    {% endif %}
                    {% if block.settings.enable_badge and block.settings.badge_text != blank %}
                        <div class="badge-testimonials color-{{ block.settings.color_scheme_badge }} body-normal">
                            {{  block.settings.badge_text }}
                        </div>
                    {% endif %}

                      {% if block.settings.slide_text != blank %}
                        <p class="testimonials__text {{ section.settings.slide_text_size }} {% if section.settings.slide_text_size == 'recommended' %} {{ text_size }} {% endif %}">
                          {{ block.settings.slide_text | escape }}
                        </p>
                      {% endif %}

                      {% if block.settings.image != blank
                        or block.settings.slide_name != blank
                        or block.settings.slide_position != blank
                      %}
                        <div style="width: 100%;" class="testimonials__author">
                          {% if section.settings.layout != 'image_left_slider'
                            and section.settings.layout != 'image_top_slider'
                          %}
                            {% if block.settings.image != blank %}
                              <div class="testimonials__author-icon">
                                {{
                                  block.settings.image
                                  | image_url: width: block.settings.image.width
                                  | image_tag: loading: '', widths: '70, 140'
                                }}
                              </div>
                            {% endif %}
                          {% endif %}
                          {% if block.settings.slide_name != blank or block.settings.slide_position != blank %}
                            <div class="testimonials__author-info"  {% if block.settings.logo_image %}style="display: flex; gap: 1.5rem; width: 100%;"{% endif %}>
                             {% style %}
                               .testimonials__author-logo-{{ block.id }} {
                                  background-color: {{ block.settings.box_color }};
                               }
                             {% endstyle %}
                              {% if block.settings.logo_image %}
                                  <div class="testimonials__author-logo testimonials__author-logo-{{ block.id }}">
                                      <img src="{{ block.settings.logo_image | img_url }}" width="80%">
                                  </div>
                             {% endif %}


                              {% if block.settings.logo_image %}
                                <div style="width: 80%;" class="testimonials__author-name-wrapper">
                              {% endif %}
                                  {% if block.settings.slide_name != blank %}
                                    <div
                                      class="
                                        testimonials__author-name
                                        {% if section.settings.layout == 'full_slider' or section.settings.layout == 'image_left_slider' %} body-large {% endif %}
                                      "
                                    >
                                      {{ block.settings.slide_name }}
                                    </div>
                                  {% endif %}
                                <div class="author-butt" style="display: flex; justify-content: space-between;">
                                  {% style %}
                                    @media (max-width: 768px) {
                                      .author-butt {
                                        flex-direction: column;
                                      }
                                    }
                                  {% endstyle %}
                                  {% if block.settings.slide_position != blank %}
                                    <div class="testimonials__author-position {% if section.settings.layout == 'simple_slider' or section.settings.layout == 'image_top_slider' %} body-small {% endif %}">
                                      {{ block.settings.slide_position }}
                                    </div>
                                  {% endif %}
                                  {% if block.settings.show_button and block.settings.button_label != blank %}
                                    {% render 'button',
                                      block_id: block.id,
                                      section_id: section.id,
                                      link: block.settings.button_link,
                                      label: block.settings.button_label,
                                      style: block.settings.button_style,
                                      class: 'case-studies'
                                    %}
                                  {% endif %}
                                  </div>
                              {% if block.settings.logo_image %}
                                </div>
                              {% endif %}
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
          {% if section.settings.enable_pagination or section.settings.enable_pagination_mobile %}
            <div
              class="
                testimonials__pagination no-js-hidden
                swiper-pagination color-{{ section.settings.pagination_color_scheme }}
                {% if section.settings.enable_pagination == false %} testimonials__pagination--desktop-hidden {% endif %}
                {% if  section.settings.enable_pagination_mobile == false %} testimonials__pagination--mobile-hidden {% endif %}
              "
            ></div>
          {% endif %}
          {% if section.settings.enable_navigation or section.settings.enable_navigation_mobile %}
            <div
              class="
                testimonials__navigation swiper-navigation no-js-hidden
                {% if section.settings.enable_pagination %} testimonials__navigation_margin {% endif %}
                {% if section.settings.enable_navigation_mobile and section.settings.enable_pagination_mobile %} testimonials__navigation--mobile-center {% endif %}
                {% if section.settings.enable_navigation == false %} testimonials__navigation--desktop-hidden {% endif %}
                {% if section.settings.enable_navigation_mobile == false %} testimonials__navigation--mobile-hidden {% endif %}
              "
            >
              <div class="testimonials__button-prev swiper-button-prev color-{{ section.settings.navigation_color_scheme }}">
                {% render 'icon-caret-left' %}
              </div>
              <div class="testimonials__button-next swiper-button-next color-{{ section.settings.navigation_color_scheme }}">
                {% render 'icon-caret-right' %}
              </div>
            </div>
          {% endif %}
        </div>
      {% else %}
        <div class="testimonials__marquee-wrapper {% if section.blocks.size > 6 %} testimonials__marquee-wrapper_full {% endif %}">
          <div class="testimonials__marquee {% if section.blocks.size > 6 %} testimonials__marquee-swiper swiper {% endif %}">
            {% if section.blocks.size > 6 %}
              <div class="swiper-wrapper">
            {% endif %}
            {%- for block in section.blocks -%}
