<style>
  :root {
  	--announcement-height: {{ section.settings.height_mobile }}px;
  }

  @media screen and (min-width: 765px) {
  	:root {
  	--announcement-height: {{ section.settings.height }}px;
  }
  }
  @media (max-width: 768px) {
    .announcement-bar {
      gap: 7px;
    }
    .announcement-bar__text {
      display: none;
    }
    .announcement-bar__text-mobile {
      font-size: 8px;
    }
    .announcement-bar__text-proven {
      font-size: 8px;
    }
    .proven-logo {
      padding-right: 2px;
    }
  }
  @media (min-width: 768px) {
    .announcement-bar__text-mobile {
      display: none;
    }
  }
</style>

{% style %}
  {% render 'section-margin' %}
{% endstyle %}

<div
  class="announcement-bar color-{{ section.settings.color_scheme }} background"
  role="region"
  aria-label="{{ 'sections.header.announcement' | t }}"
  style="justify-content: space-between;"
>
  {%- if section.settings.text != blank or section.settings.text_2 != blank -%}
    <div class="announcement-bar__message">
      {%- if section.settings.icon != 'none' -%}
        <div
          class="announcement-bar__icon announcement-bar__icon--{{- section.settings.icon_style }} announcement-bar__icon--{{- section.settings.icon_fill_type }} color-{{ section.settings.icon_color_scheme }}"
        >
          {% render 'icon-selector',
            icon_type: section.settings.icon_type,
            icon_pack_icon: section.settings.icon_pack,
            svg_icon: section.settings.svg_icon,
            width: '30',
            height: '30',
            icon_pack_icon_style: section.settings.icon_style,
            icon_pack_icon_fill_type: section.settings.icon_fill_type,
            section:section
          %}
        </div>
      {%- endif -%}
      <div class="announcement-bar__text">{{ section.settings.text }}</div>
      <div class="announcement-bar__text-mobile">{{ section.settings.text_mobile }}</div>
    </div>
    <div class="announcement-bar__message">
      {% if section.settings.enable_stars %}
        <div class="star-icon" style="margin-bottom: -5px;">
          {% style %}
            @media (max-width: 768px) {
              .star-icon {
                display: flex;
                margin-bottom: 0px !important;
              }
              .announcement-bar__message {
                padding: 0px;
                font-size: 10px;
                gap: 5px;
              }
            }
          {% endstyle %}
          {% render "icon-star-custom" , width: "15", height: "15", color: color %}
          {% render "icon-star-custom" , width: "15", height: "15", color: color %}
          {% render "icon-star-custom" , width: "15", height: "15", color: color %}
          {% render "icon-star-custom" , width: "15", height: "15", color: color %}
          {% render "icon-star-custom" , width: "15", height: "15", color: color %}
        </div>
      {% endif %}
      <div class="announcement-bar__text-proven">
        {{ section.settings.text_2 }}
      </div>
      {% if section.settings.image != blank %}
        <div class="proven-logo">
          <img src="{{ section.settings.image | img_url }}" alt="Proven-logo" height="auto" width="32">
        </div>
      {% endif %}
    </div>
  {%- endif -%}
</div>

