            { "value": "20", "label": "20" },
            { "value": "25", "label": "25" },
            { "value": "30", "label": "30" },
            { "value": "35", "label": "35" },
            { "value": "40", "label": "40" },
            { "value": "45", "label": "45" },
            { "value": "50", "label": "50" },
            { "value": "55", "label": "55" },
            { "value": "60", "label": "60" }
          ]
        },
        {
          "type": "text",
          "id": "combo_2_heading",
          "label": "Combo 2 heading"
        },
        {
          "type": "select",
          "id": "combo_2_heading_tag",
          "label": "Combo 2 heading tag",
          "options": [
            { "value": "p", "label": "p" },
            { "value": "h1", "label": "h1" },
            { "value": "h2", "label": "h2" },
            { "value": "h3", "label": "h3" },
            { "value": "h4", "label": "h4" },
            { "value": "h5", "label": "h5" },
            { "value": "h6", "label": "h6" }
          ],
          "default": "h5"
        },
        {
          "type": "richtext",
          "id": "combo_2_text",
          "label": "Combo 2 text"
        },
        {
          "type": "select",
          "id": "combo_2_placement",
          "label": "Combo 2 placement",
          "default": "left",
          "options": [
            { "value": "full", "label": "Full width" },
            { "value": "left", "label": "Left column" },
            { "value": "right", "label": "Right column" }
          ]
        },
        {
          "type": "select",
          "id": "combo_2_order",
          "label": "Combo 2 order",
          "default": "20",
