{{ 'section-pricing-table.css' | asset_url | stylesheet_tag }}

{% render 'anchor', anchor_id: section.settings.anchor_id %}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
  #shopify-section-{{ section.id }} .pricing-table__item-list ul{
    gap:.4rem;
  }
  #shopify-section-{{ section.id }} .pricing-table__item-list ul li{
    display:flex;
  }

  /* Tabs style */
  #shopify-section-{{ section.id }} .tab-button-wrapper {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  #shopify-section-{{ section.id }} .tab-button {
    color:{{ section.settings.btn_text_color }};
    border-radius: 10rem;
    border: solid {{ section.settings.btn_border_color }} 1px;
    padding: .5rem 2rem;
    background-color:{{ section.settings.btn_bg }};
  }

  #shopify-section-{{ section.id }} .tab-button-active {
    border-radius: 10rem;
    background-color: {{ section.settings.btn_active_bg }};
    padding: .5rem 2rem;
    color:{{ section.settings.btn_active_text_color }};
  }

  #shopify-section-{{ section.id }} .tab-content{
    height:0 !important;
    visibility: hidden;
  }

  #shopify-section-{{ section.id }} .pricing-tab__item-title {
    font-weight: bolder;
    font-size: calc(var(--font-body-scale) * 1.5rem);
  }

  #shopify-section-{{ section.id }} .pricing-tab__items {
    background: transparent !important;
  }

  #shopify-section-{{ section.id }} .carousel-cell {
    width: 30%;
    border-radius: 5px;
    counter-increment: carousel-cell;
    margin:1.5%;
    box-shadow:none;
  }
  #shopify-section-{{ section.id }} .highlight-border{
    border: solid {{ section.settings.tab_border_color }} 1px;
  }

  #shopify-section-{{ section.id }} .section-text-wrapper{
    padding: 2rem;
  }

  {% if section.settings.header_min_height > 0 %}
    @media screen and (min-width: 576px) {
      #shopify-section-{{ section.id }} .pricing-table__item-header {
        min-height: {{ section.settings.header_min_height }}px;
      }
    }
  {% endif %}

  @media only screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .carousel-cell {
      width: 90%;
      margin:5%;
    }
  }
{%- endstyle -%}

<div class="pricing-table color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding
  {% if section.settings.enable_border %} section-border {% if section.settings.border_full %} section-border-full {% endif %} {% endif %}" style="overflow: visible;">
  <div class="container" {% if section.settings.enable_fullscreen %}style="padding: 0;"{% endif %}>
    <div class="section-text-wrapper">
    {% render 'section-text',
      section: section,
      class: 'pricing-table',
      text_align: section.settings.text_align
    %}
   </div>
    <div class="content pricing-table__content">
      <div class="pricing-tab-container">
        {% comment %} Tab Nav {% endcomment %}
        <div class="tab-button-wrapper">
          {% assign index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == "tab" and block.settings.title != blank %}
              <a class="button {% if index == 0 %}tab-button-active{% else %}tab-button{% endif %}" data-tab="tab{{ forloop.index }}">
                {{ block.settings.title }}
              </a>
              {% assign index = index | append : 1 %}
            {% else %}
              {% continue %}
            {% endif %}
          {% endfor %}
        </div>
        {% comment %} Tab Nav {% endcomment %}

        {% comment %} Tab Body {% endcomment %}
        <div class="tab-folder">
          {% assign index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == "tab" and block.settings.title != blank %}
              {% assign id = block.settings.id %}
              <div id="tab{{ forloop.index }}"  class="tab {% if index != 0  %}tab-content{% endif %}">
                <div class="pricing-tab__items carousel" data-flickity='{ "groupCells": true, "prevNextButtons": false, "pageDots": false }'>
                  {% for block in section.blocks %}
                    {% if block.type == "price" or  block.type == "custom"  %}
                      {% if block.settings.id == id %}
                        {% style %}
                          #shopify-section-{{ section.id }} .carousel-cell-{{ block.id }}  a.pricing-table__button{
                            margin-top:2rem;
                            width:100%;
                            opacity:1;
                            background-color: {{ block.settings.button_background }};
                            color: {{ block.settings.button_text_color }} !important;
                          }
                          #shopify-section-{{ section.id }} .carousel-cell-{{ block.id }}  a.pricing-table2__button{
                            margin-top:2rem;
                            width:100%;
                            opacity:1;
                            background-color: {{ block.settings.button_background2 }};
                            color: {{ block.settings.button_text_color2 }} !important;
                          }
                          #shopify-section-{{ section.id }} .carousel-cell-{{ block.id }}{
                            padding: 2.4rem 0;
                          }
                          #shopify-section-{{ section.id }} .carousel-cell-{{ block.id }} .pricing-table__badge{
                            background-color: {{ block.settings.badge_bg }};
                            color: {{ block.settings.badge_color }};
                            font-weight: 500;
                            top:4.8rem;
                          }
                          {% if block.settings.heading_icon != "none" or block.settings.heading_svg_icon != "none" %}
                            #shopify-section-{{ section.id }} .carousel-cell-{{ block.id }} .pricing-table__item-price {
                              display: grid;
                              grid-template-columns: 12% 88%;
                            }
                          {% endif %}
                          {% if block.settings.button_style == "simple_link"%}
                            #shopify-section-{{ section.id }} .carousel-cell-{{ block.id }} .pricing-table2__button {
                              justify-content: center;
                              min-height: 4.8rem;
                              background-color: white !important;
                            }
                          {% endif %}
                          {% if block.settings.button_style1 == "simple_link"%}
                            #shopify-section-{{ section.id }} .carousel-cell-{{ block.id }} .pricing-table__button {
                              justify-content: center;
                              min-height: 4.8rem;
                              background-color: white !important;
                            }
                          {% endif %}
                        {% endstyle %}
                        <div class="carousel-cell carousel-cell-{{ block.id }} pricing-table__item pricing-table__item_shadow  color-{{ block.settings.color_scheme }} {% if block.settings.highlight %} highlight-border {% endif %}" >
                          <div class="pricing-table__item-header p-2_4">
                            {% if block.settings.badge_text != blank %}
                              <span class="pricing-table__badge subtitle subtitle--secondary">
                                    {% if block.settings.icon != 'none' %}
                                      <i class="icon icon-pack icon-{{ block.settings.badge_icon }}"></i>
                                    {% endif %}
                                {{ block.settings.badge_text }}
                              </span>
                            {% endif %}
                            {% if block.settings.heading_price != blank %}
                              <{{ block.settings.heading_tag }} class="title pricing-table__item-title pricing-tab__item-title {% if block.settings.badge_text != blank %} pricing-table__item-title_with-badge {% endif %}">
                                {{ block.settings.heading_price }}
                              </{{ block.settings.heading_tag }}>
                            {% endif %}
                            {% if block.settings.heading != blank %}
                              <div style="gap: 10px;" class="pricing-table__item-price mt-4 {{ section.settings.heading_size_price }}
                                {% if block.settings.color_scheme.settings.color_accent_gradient != empty and block.type == 'custom' %} text-gradient {% endif %}">                         
                                {% if block.settings.heading_icon != "none" or block.settings.heading_svg_icon != "none" %}
                                  <div class="icon-head">
                                    {% style %}
                                      .icon-head {
                                        justify-content: center;
                                        display: flex; 
                                        width: 40px; 
                                        height: 40px; 
                                        border-radius: 5px; 
                                        background-color: {{ block.settings.icon_background }};
                                        align-items: center;
                                      }
                                    {% endstyle %}
                                    {%
                                      render "icon-selector",
                                      icon_type:block.settings.heading_icon_type,
                                      icon_pack_icon: block.settings.heading_icon,
                                      svg_icon: block.settings.heading_svg_icon,
                                      width: "24",
                                      height: "24",
                                      color: block.settings.icon_color,
                                      section: block
                                    %}
                                  </div>
                                {% endif %}
                                {{ block.settings.heading }}
                              </div>
                            {% endif %}
                            {% if block.settings.description != blank %}
                              <p class="pricing-table__item-description">
                                {{ block.settings.description }}
                              </p>
                            {% endif %}
                            <div class="spacer"></div>
                            {% if block.settings.show_button or block.settings.show_button2 %}
                              <div class="button-container">
                                {%- if block.settings.show_button -%}
                                  {% render 'button',
                                    block_id: block.id,
                                    section_id: section.id,
                                    link: block.settings.button_link,
                                    label: block.settings.button_label,
                                    style: block.settings.button_style1,
                                    class: 'pricing-table'
                                  %}
                                {% endif %}
                                {%- if block.settings.show_button2 -%}
                                  {% render 'button',
                                    block_id: block.id,
                                    section_id: section.id,
                                    link: block.settings.button_link2,
                                    label: block.settings.button_label2,
                                    style: block.settings.button_style,
                                    class: 'pricing-table2'
                                  %}
                                {% endif %}
                              </div>
                            {% endif %}
                          </div>


                          {% if block.type == 'price' and block.settings.features_list != blank %}
                            <div class="pricing-table__item-list p-2_4 {% if block.settings.footer_text != blank %}bottom-border-line{% endif %}">
                              {% if block.settings.features_list_heading != blank %}
                                <p class="pricing-table__item-description">{{ block.settings.features_list_heading }}</p>
                              {% endif %}
                              {{ block.settings.features_list }}
                            </div>
                          {% endif %}

                          {% if block.settings.footer_text != blank %}      
                          <div style="padding: 0 2.4rem;">
                              <p class="pricing-table__item-description">
                                {{ block.settings.footer_text }}
                              </p>
                          </div>
                          {% endif %}

                        </div>
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </div>

              </div>
              {% assign index = index | append : 1 %}
            {% else %}
              {% continue %}
            {% endif %}
            <script>
              (() => {
                function registerEventListeners() {
                  setTimeout(function () {


                const carouselCells = document.querySelectorAll('#tab{{ forloop.index }} .carousel-cell');
                var HighestTotalCellHeight = 0;
                var HighestMargin = 0;
                  
                if (carouselCells) {
                  // Find the highest total height of the carousel cells
                  carouselCells.forEach((cell) => {
                    let cellHeight = cell.offsetHeight;
                    if (HighestTotalCellHeight < cellHeight) {
                      HighestTotalCellHeight = cellHeight;
                    }
                  });

                  // Set the height of the carousel cells to the highest total height
                  carouselCells.forEach((cell) => {
                    
                    let cellHeight = cell.offsetHeight;
                    if (HighestTotalCellHeight > cellHeight) {
                      cell.style.height = `${HighestTotalCellHeight}px`;
                      window.dispatchEvent(new Event('resize'));
                    }
                  });
                }
                  },1000)
                }
                document.addEventListener('DOMContentLoaded', registerEventListeners);
                document.addEventListener('shopify:section:load', registerEventListeners);
              })();
            </script>
          {% endfor %}
        </div>
        {% comment %} Tab Body {% endcomment %}
      </div>

    </div>
  </div>
</div>


<script>
  let tab_buttons = document.querySelectorAll("#shopify-section-{{ section.id }} .tab-button-wrapper a.button");
  tab_buttons.forEach(button => {
    button.addEventListener("click",function () {
      resetTabButtons(tab_buttons);
      activateButton(button);

      let tabs = document.querySelectorAll("#shopify-section-{{ section.id }} .tab-folder div.tab");
      resetTabs(tabs);

      let tabId = button.getAttribute("data-tab");
      let tab = document.querySelector("#shopify-section-{{ section.id }} .tab-folder #" + tabId);
      activateTab(tab);
    })
  })
</script>

{% schema %}
{
  "name": "Pricing tabs",
  "tag": "section",
  "class": "pricing-table-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "enable_fullscreen",
      "label": "Full screen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_border",
      "label": "t:sections.all.enable_border.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_full",
      "label": "t:sections.all.border_full.label",
      "default": false
