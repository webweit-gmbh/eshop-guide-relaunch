{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

{% render 'anchor', anchor_id: section.settings.anchor_id %}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  .section-{{ section.id }}-padding .image-with-text__media::before {
    background-color: rgba(var(--color-overlay), {{ section.settings.overlay_opacity }});
  }

  {% if section.settings.image != blank %}
    .section-{{ section.id }}-padding .image-with-text__media--adapt,
    .section-{{ section.id }}-padding .image-with-text__media--all-height-adapt {
      padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 | round: 2 }}%;
    }
  {% endif %}

  {% if section.settings.background_image != blank %}
    #shopify-section-{{ section.id }} .background_image {
      background-image: url({{ section.settings.background_image | img_url: 'master' }});
      background-size: {{ section.settings.background_size }};
      background-position: center;
      background-attachment: unset;
    }
  {% endif %}

  {% if section.settings.background_gradient != blank %}
    #shopify-section-{{ section.id }} .image-with-text {
      background: {{ section.settings.background_gradient }};
    }
  {% endif %}

  #shopify-section-{{ section.id }} .image-with-text__highlight *{
    margin: 0;
  }
{%- endstyle -%}

