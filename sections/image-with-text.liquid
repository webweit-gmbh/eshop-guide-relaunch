<div class="image-with-text color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding {% if section.settings.background_image != blank %}background_image{% endif %}">
  {% if section.settings.full_width == false %}
    <div class="container">
  {% endif %}
  <div class="image-with-text color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding {% if section.settings.background_image != blank %}background_image{% endif %}">
    <div class="{% if section.settings.full_width %}container{% endif %}">
      {% render 'section-text', section: section, class: 'image-with-text', text_align: section.settings.text_align %}

      <div class="image-with-text__content content">
        {% if section.settings.enable_column %}
          {% style %}
            #shopify-section-{{ section.id }} .image-with-text__columns {
              grid-template-columns: repeat(3, 1fr);
            }
          {% endstyle %}
        {% endif %}
        <div class="image-with-text__grid image-with-text__grid--{{ section.settings.layout }} {% if section.settings.layout == 'text_last' %} image-with-text__grid--reverse{% endif %} image-with-text__grid--{{ section.settings.text_align_inner }}">
          {% if section.settings.layout == 'image_center' %}
            {% if section.blocks.size > 0 %}
              <div class="image-with-text__columns image-with-text__columns--image_center">
                {% for block in section.blocks %}
                  {% if block.type == 'highlight' %}
                    {% continue %}
                  {% endif %}
                  {% assign mod = forloop.index | modulo: 2 %}
                  {% if mod == 1 %}
                    <div class="image-with-text__column" {{ block.shopify_attributes }}>
                        <div
                          class="
                            image-with-text__column-icon
                            image-with-text__column-icon--{{- section.settings.icon_size }}
                            {% if section.settings.box_shadow %}image-with-text__column-icon--shadow {% endif %}
                            image-with-text__column-icon--{{- section.settings.icon_style }}
                            image-with-text__column-icon--{{- block.settings.icon_fill_type }}
                          "
                        >
                          {% render 'icon-selector',
                            icon_type: block.settings.icon_type,
                            icon_pack_icon: block.settings.icon,
                            svg_icon: block.settings.svg_icon,
                            icon_pack_icon_style: section.settings.icon_style,
                            icon_pack_icon_fill_type: block.settings.icon_fill_type,
                            width: '45',
                            height: '45',
                            color: block.settings.icon_color
                          %}
                        </div>
                      {% if block.settings.heading != blank %}
                        <{{ block.settings.heading_tag }} class="image-with-text__column-title h5">
                          {{ block.settings.heading }}
                        </{{ block.settings.heading_tag }}>
                      {% endif %}
                      {% if block.settings.text %}
                        <div class="image-with-text__column-text">
                          {{ block.settings.text }}
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
              {% for block in section.blocks %}
                {% if block.type == 'column' %}
                  {% continue %}
                {% endif %}
                {% style %}
                  #shopify-section-{{ section.id }} .image-with-text__highlight--{{ block.id }} {
                    background-color: {{ block.settings.background_color }};
                    color: {{ block.settings.text_color }};
                    font-size: {{ block.settings.font_size }}px;
                    border-radius: {{ block.settings.border_radius }}px;
                    padding: {{ block.settings.padding }}px;
                    margin: {{ block.settings.margin }}px 0;
                    {% if block.settings.use_full_width %}
                    width: 100%;
                    {% endif %}
                  }
                {% endstyle %}
                {% if block.settings.highlight_text != blank %}
                  <div class="image-with-text__highlight image-with-text__highlight--{{ block.id }}" {{ block.shopify_attributes }}>
                    {{ block.settings.highlight_text }}
                  </div>
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endif %}
          <div class="image-with-text__left image-with-text__left--{{ section.settings.height }}">
            <div
              class="
                image-with-text__media
                image-with-text__media--{{ section.settings.height }}
                {% if section.settings.height == 'all-height' and section.settings.layout == 'image_center' %}
                  {% if section.settings.inner_heading != blank or section.settings.description != blank
                    or section.settings.show_button or section.settings.show_button_2 %}
                    image-with-text__media--all-height-adapt
                  {% endif %}
                {% endif %}
                {% if section.settings.image != blank %}
                {% else %}image-with-text__media--placeholder placeholder{% endif %}
              "
            >
              <div class="{% if section.settings.enable_custom_additional_text_style %} image-with-text__bottom {% else %} image-with-text__top {% endif %} color-{{ section.settings.author_color_scheme }}">
                {% if section.settings.logo != blank or section.settings.logo_dm %}
                  {%- assign width = section.settings.logo_width -%}
                  {%- assign width_adapt = section.settings.logo_width | times: 0.8 | round: 2 -%}

                  {% capture sizes %}
                  (min-width: 1100px) {{ width }}px, 
                  (min-width: 750px) {{ width_adapt }}px
                {% endcapture %}

                  {% capture widths %}
                  {{ width | times: 2 }}, {{ width_adapt | times: 2 }}
                {% endcapture %}

                  {% capture style %}
                  --width-adapt: {{ width_adapt }}px
                {% endcapture %}

                  <div class="image-with-text__logos">
                    {%- if section.settings.logo_dm != blank -%}
                      {{
                        section.settings.logo_dm
                        | image_url: width: width
                        | image_tag:
                          loading: '',
                          sizes: sizes,
                          widths: widths,
                          height: 'auto',
                          width: width,
                          class: ' image-with-text__logo image-with-text__logo--dark',
                          style: style
                      }}
                    {%- endif -%}
                    {%- if section.settings.logo != blank -%}
                      {{
                        section.settings.logo
                        | image_url: width: width
                        | image_tag:
                          loading: '',
                          sizes: sizes,
                          widths: widths,
                          height: 'auto',
                          width: width,
                          class: ' image-with-text__logo image-with-text__logo--light',
                          style: style
                      }}
                    {%- endif -%}
                  </div>
                {% endif %}
                {% unless section.settings.enable_custom_additional_text_style %}
                  {% if section.settings.add_text %}
                    <div class="image-with-text__add-text subtitle">
                      {{ section.settings.add_text }}
                    </div>
                  {% endif %}
                {% else %}
                  <div class="image-with-text__add-text--custom">
                    {%- 
                      liquid
                      assign rgb = section.settings.caption_background | color_to_rgb
                      assign tail = section.settings.caption_opacity | prepend: ', ' | append: ')' 
                    -%}
                    {% style %}
                      #shopify-section-{{ section.id }} .image-with-text__add-text--custom {
                        background-color: {{ rgb | replace: 'rgb', 'rgba' | replace: ')', tail }};
                      }
                    {% endstyle %}
                    {% if section.settings.additional_custom_text_heading != blank %}
                      <h3 style="font-size: {{ section.settings.heading_width }}px;" class="margin-0">{{ section.settings.additional_custom_text_heading }}</h3>
                    {% endif %}

                    {% if section.settings.additional_custom_text != blank %}
                      <span style="font-size: {{ section.settings.subheading_width }}px;">{{ section.settings.additional_custom_text }}</span>
                    {% endif %}
                  </div>
                {% endunless %}
              </div>

              {%- if section.settings.image != blank -%}
                {% if section.settings.formate_picker == 'image' %}
                  {% capture sizes %}
                    (min-width: 990px) 50vw - 40px, 
                    calc((100vw - 40px))
                  {% endcapture %}
                  {{
                    section.settings.image
                    | image_url: width: section.settings.image.width
                    | image_tag:
                      loading: '',
                      sizes: sizes,
                      widths: '360, 535, 720, 940, 1070, 1200, 1400, 1600, 1800, 2000, 2200'
                  }}
                {% else %}
                  {% if section.settings.video_object_fit %}
                    {% style %}
                      #shopify-section-{{ section.id }} .slideshow__video video {
                        object-fit: cover;
                      }
                    {% endstyle %}
                  {% endif %}
                  {% if section.settings.video_overlay_image %}
                    {% style %}
                      #shopify-section-{{ section.id }} .image_with_overlay {
                        width: 100%;
                        height: 100%;
                        position: absolute;
                      }
                      #shopify-section-{{ section.id }} .image_with_overlay .video_container {
                        position: absolute;
                        top: 0;
                        left: 50%;
                        transform: translate(-50%, 0);
                        width: unset;
                        height: 100%;
                        z-index: 9;
                        padding: {{ section.settings.video_overlay_margin_top }}% 0% {{ section.settings.video_overlay_margin_bottom }}%;
                      }
                      #shopify-section-{{ section.id }} .image_with_overlay video {
                        border-bottom-left-radius: 2em;
                        border-bottom-right-radius: 2em;
                        height: 100%;
                        height: -webkit-fill-available;
                      }
                    {% endstyle %}
                    <div class="image_with_overlay">
                      <img 
                        src="{{ section.settings.video_overlay_image | img_url: '2000x' }}" 
                        alt="" 
                        style="
                          position: absolute;
                          top: 0;
                          left: 50%;
                          transform: translate(-50%, 0);
                          width: unset;
                          height: 100%;
                          z-index: 10;
                          margin: auto;
                        "
                      />
                      <div class="video_container">
                        {{
                          section.settings.video
                          | video_tag: image_size: '1920x', autoplay: true, loop: true, controls: false, muted: true
                        }}
                      </div>
                    </div>

                  {% else %}
                    <div class="slideshow__video video">
                      {{
                        section.settings.video
                        | video_tag: image_size: '1920x', autoplay: true, loop: true, controls: false, muted: true
                      }}
                    </div>
                  {% endif %}
                {% endif %}
              {%- else -%}
                {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </div>
          {% if section.settings.layout == 'image_center' %}
            {% if section.blocks.size > 0 %}
              <div class="image-with-text__columns image-with-text__columns--image_center">
                {% for block in section.blocks %}
                  {% if block.type == 'highlight' %}
                    {% continue %}
                  {% endif %}
                  {% assign mod = forloop.index | modulo: 2 %}
                  {% if mod == 0 %}
                    <div class="image-with-text__column" {{ block.shopify_attributes }}>
                        <div
                          class="
                            image-with-text__column-icon
                            image-with-text__column-icon--{{- section.settings.icon_size }}
                            {% if section.settings.box_shadow %}image-with-text__column-icon--shadow {% endif %}
                            image-with-text__column-icon--{{- section.settings.icon_style }}
                            image-with-text__column-icon--{{- block.settings.icon_fill_type }}
                          "
                        >
                          {% render 'icon-selector',
                            icon_type: block.settings.icon_type,
                            icon_pack_icon: block.settings.icon,
                            svg_icon: block.settings.svg_icon,
                            icon_pack_icon_style: section.settings.icon_style,
                            icon_pack_icon_fill_type: block.settings.icon_fill_type,
                            width: '45',
                            height: '45',
                            color: block.settings.icon_color
                          %}
                        </div>
                      {% if block.settings.heading != blank %}
                        <{{ block.settings.heading_tag }} class="image-with-text__column-title h5">
                          {{ block.settings.heading }}
                        </{{ block.settings.heading_tag }}>
                      {% endif %}
                      {% if block.settings.text %}
                        <div class="image-with-text__column-text">
                          {{ block.settings.text }}
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
              {% for block in section.blocks %}
                {% if block.type == 'column' %}
                  {% continue %}
                {% endif %}
                {% style %}
                  #shopify-section-{{ section.id }} .image-with-text__highlight--{{ block.id }} {
                    background-color: {{ block.settings.background_color }};
                    color: {{ block.settings.text_color }};
                    font-size: {{ block.settings.font_size }}px;
                    border-radius: {{ block.settings.border_radius }}px;
                    padding: {{ block.settings.padding }}px;
                    margin: {{ block.settings.margin }}px 0;
                    {% if block.settings.use_full_width %}
                    width: 100%;
                    {% endif %}
                  }
                {% endstyle %}
                {% if block.settings.highlight_text != blank %}
                  <div class="image-with-text__highlight image-with-text__highlight--{{ block.id }}" {{ block.shopify_attributes }}>
                    {{ block.settings.highlight_text }}
                  </div>
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endif %}
          {% if section.settings.layout != 'image_center' %}
            <div class="image-with-text__right">
              {%- if section.settings.inner_subheading != blank -%}
                <{{ section.settings.inner_subheading_tag }} class="image-with-text__inner-subheading subtitle {% if section.settings.inner_subheading_style == 'badge' %}subtitle-badge{% endif %}">
                  {{ section.settings.inner_subheading }}
                </{{ section.settings.inner_subheading_tag }}>
              {%- endif -%}
              {%- if section.settings.inner_heading != blank -%}
                <{{ section.settings.inner_heading_tag }}
                  class="
                    image-with-text__inner-heading title--section title--{{ section.settings.inner_heading_line }}
                    {% if section.settings.inner_word_break and section.settings.inner_heading_line != 'none' %} title--word_break {% endif %}
                  "
                  style="--color-line-inner: {{ section.settings.inner_line_color }}"
                >
                  {{ section.settings.inner_heading }}
                </{{ section.settings.inner_heading_tag }}>
              {%- endif -%}
              {% if section.settings.description != blank %}
                <div class="image-with-text__text {{ section.settings.description_text_size }}">
                  {{ section.settings.description }}
                </div>
              {% endif %}

              {% if section.blocks.size > 0 %}
                <div class="image-with-text__columns">
                  {% for block in section.blocks %}
                    {% if block.type == 'highlight' %}
                      {% continue %}
                    {% endif %}
                    <div class="image-with-text__column" {{ block.shopify_attributes }}>
                      {% style %}
                      {% if block.settings.enable_box %}
                        #shopify-section-{{ section.id }} .image-with-text__column-icon--{{ block.id }} {
                          display: flex ;
                          justify-content: center;
                          padding: 1rem;
                          background-color: {{ block.settings.box_color }};
                          border-radius: 6px;
                        }
                      {% endif %}
                      {% endstyle %}
                        <div
                          class="
                          image-with-text__column-icon--{{ block.id }}
                            image-with-text__column-icon
                            image-with-text__column-icon--{{- section.settings.icon_size }}
                            {% if section.settings.box_shadow %}image-with-text__column-icon--shadow {% endif %}
                            image-with-text__column-icon--{{- section.settings.icon_style }}
                            image-with-text__column-icon--{{- block.settings.icon_fill_type }}
                          "
                        >
                          {% render 'icon-selector',
                            icon_type: block.settings.icon_type,
                            icon_pack_icon: block.settings.icon,
                            svg_icon: block.settings.svg_icon,
                            icon_pack_icon_style: section.settings.icon_style,
                            icon_pack_icon_fill_type: block.settings.icon_fill_type,
                            width: '45',
                            height: '45',
                            color: block.settings.icon_color
                          %}
                        </div>
                      {% if block.settings.heading != blank %}
                        <{{ block.settings.heading_tag }} class="image-with-text__column-title h5">
                          {{ block.settings.heading }}
                        </{{ block.settings.heading_tag }}>
                      {% endif %}
                      {% if block.settings.text %}
                        <div class="image-with-text__column-text">
                          {{ block.settings.text }}
                        </div>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
                {% for block in section.blocks %}
                  {% if block.type == 'column' %}
                    {% continue %}
                  {% endif %}
                  {% style %}
                    #shopify-section-{{ section.id }} .image-with-text__highlight--{{ block.id }} {
                      background-color: {{ block.settings.background_color }};
                      color: {{ block.settings.text_color }};
                      font-size: {{ block.settings.font_size }}px;
                      border-radius: {{ block.settings.border_radius }}px;
                      padding: {{ block.settings.padding }}px;
                      margin: {{ block.settings.margin }}px 0;
                      {% if block.settings.use_full_width %}
                      width: 100%;
                      {% endif %}
                    }
                  {% endstyle %}
                  {% if block.settings.highlight_text != blank %}
                    <div class="image-with-text__highlight image-with-text__highlight--{{ block.id }}" {{ block.shopify_attributes }}>
                      {{ block.settings.highlight_text }}
                    </div>
                  {% endif %}
                {% endfor %}
              {% endif %}

              {%- if section.settings.show_button or section.settings.show_button_2 -%}
                <div class="image-with-text__buttons" {{ block.shopify_attributes }}>
                  {%- if section.settings.show_button -%}
                    {% render 'button',
              block_id: block.id,
              section_id: section.id,
                      link: section.settings.button_link,
                      label: section.settings.button_label,
                      style: section.settings.button_style,
                      class: 'image-with-text'
                    %}
                  {%- endif -%}
                  {%- if section.settings.show_button_2 -%}
                    {% render 'button',
              block_id: block.id,
              section_id: section.id,
                      link: section.settings.button_link_2,
                      label: section.settings.button_label_2,
                      style: section.settings.button_style_2,
                      class: 'image-with-text'
                    %}
                  {%- endif -%}
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>

        {% if section.settings.layout == 'image_center' %}
          {%- if section.settings.inner_subheading != blank
            or section.settings.inner_heading != blank
            or section.settings.description != blank
          -%}
            <div class="image-with-text__text-center">
              {%- if section.settings.inner_subheading != blank -%}
                <div class="image-with-text__inner-subheading subtitle">
                  {{ section.settings.inner_subheading }}
                </div>
              {%- endif -%}
              {%- if section.settings.inner_heading != blank -%}
                <h2 class="image-with-text__inner-heading">
                  {{ section.settings.inner_heading }}
                </h2>
              {%- endif -%}
              {% if section.settings.description != blank %}
                <div class="image-with-text__text  {{ section.settings.description_text_size }}">
                  {{ section.settings.description }}
                </div>
              {% endif %}
            </div>
          {% endif %}
          {%- if section.settings.show_button or section.settings.show_button_2 -%}
            <div class="image-with-text__buttons image-with-text__buttons--center">
              {%- if section.settings.show_button -%}
                {% render 'button',
              block_id: block.id,
              section_id: section.id,
                  link: section.settings.button_link,
                  label: section.settings.button_label,
                  style: section.settings.button_style,
                  class: 'image-with-text'
                %}
              {%- endif -%}
              {%- if section.settings.show_button_2 -%}
                {% render 'button',
              block_id: block.id,
              section_id: section.id,
                  link: section.settings.button_link_2,
                  label: section.settings.button_label_2,
                  style: section.settings.button_style_2,
                  class: 'image-with-text'
                %}
              {%- endif -%}
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
  {% if section.settings.full_width == false %}
    </div>
  {% endif %}
</div>
