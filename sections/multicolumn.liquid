{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}

{% render 'anchor', anchor_id: section.settings.anchor_id %}

{% style %}
   {% render 'section-padding' %}
   {% render 'section-margin' %}

  @media screen and (min-width: 576px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .multicolumn--separators .multicolumn-card:nth-child(2n - 1) {
      padding-left: 0!important;
      border: none;
    }
  }


  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .multicolumn--separators .multicolumn-card:nth-child({{ section.settings.multicolumn_to_show }}n + 1) {
      padding-left: 0!important;
      border: none;
    }
  }

  {% if section.settings.layout_style == "secondary" or section.settings.content_alignment_horizontal %}
    #shopify-section-{{ section.id }} .multicolumn-card{
      flex-direction:row !important;
      align-items: center !important;
    }

    #shopify-section-{{ section.id }} .multicolumn-card .multicolumn-card__image-wrapper{
      align-self: center !important;
    }

    #shopify-section-{{ section.id }} .multicolumn-card__image-wrapper{
      aspect-ratio: 1 / 1;
      padding: {{ section.settings.icon_padding }}px;
    }
  {% endif %}

  {% if section.settings.layout_style == "secondary" %}
    #shopify-section-{{ section.id }} .secondary_container{
      gap:5rem;
    }

    @media screen and (max-width: 746px) {
     #shopify-section-{{ section.id }} .secondary_container{
        flex-wrap: wrap;
        gap:2rem;
     }
    }

    @media screen and (min-width: 576px) and (min-width: 746px) {
     #shopify-section-{{ section.id }} .multicolumn-list__wrapper--static.multicolumn-list__wrapper--3 {
        grid-template-columns: repeat(2, 1fr);
      }
    }


    @media screen and (min-width: 1500px) {
     #shopify-section-{{ section.id }} .multicolumn-list__wrapper--static.multicolumn-list__wrapper--4 {
        grid-template-columns: repeat(3, 1fr);
      }
    }


    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .titles+.description {
        margin-top: 6rem;
      }
    }
  {% endif %}

  {% if section.settings.layout_style == "tertiary" %}
    #shopify-section-{{ section.id }} .tertiary_card{
      border-radius: 1rem;
      box-shadow: 1px 1px 15px #eaeaea;
      gap:0 !important;
    }
    #shopify-section-{{ section.id }} .tertiary_card_info{
      padding:2rem;
    }
  {% endif %}

  {% if section.settings.button_full_width %}
    #shopify-section-{{ section.id }} .multicolumn-card__info a.button{
      width:100% !important;
    }
  {% endif %}

  {% if section.settings.button_on_bottom %}
    #shopify-section-{{ section.id }} .tertiary_card a.button{
      margin:2rem;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .multicolumn-card__content {
    flex-direction: {{ section.settings.icon_position }};
  }
{% endstyle %}

{% capture section_text_common %}
  {% render 'section-text', section: section, class: 'multicolumn', text_align: section.settings.text_align %}
{% endcapture %}

{% capture section_text_secondary %}
  <div class="section_text_wrapper_" style="width:100vw;">
    {% render 'section-text', section: section, class: 'multicolumn', text_align: section.settings.text_align %}
  </div>
{% endcapture %}

{% capture container_class_secondary_style %} d-flex secondary_container{% endcapture %}


{% if section.settings.full_width == false %}
  <div class="container{% if section.settings.layout_style == "secondary" %} {{ container_class_secondary_style }}{% endif %}">
{% endif %}
<div class="
    multicolumn color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding
    {% if section.settings.enable_border %} section-border {% if section.settings.border_full %} section-border-full {% endif %} {% endif %}
    multicolumn-gap--{{ section.settings.gap }}
    multicolumn--{% if section.settings.section_type == 'separators' %}separators{% elsif section.settings.section_type == 'transparent' %}transparent{% elsif section.settings.section_type == 'solid' %}solid{% endif %}
  ">

  <div class="{% if section.settings.full_width %}container{% if section.settings.layout_style == "secondary" %} {{ container_class_secondary_style }}{% endif %}{% endif %}">
    {% if section.settings.layout_style == "secondary" %}
      {{ section_text_secondary }}
    {% else %}
      {{ section_text_common }}
    {% endif %}

    <div
      class="multicolumn-list__wrapper multicolumn-list__wrapper--{{ section.settings.multicolumn_to_show }} multicolumn-list__wrapper--static content"
      style="gap:1.5rem !important;"
    >
      {% for block in section.blocks %}
        {% style %}
          {% if block.settings.background_gradient != blank %}
            #shopidy-block-{{ block.id }}.multicolumn-card {
              background: {{ block.settings.background_gradient }};
            }
          {% endif %}
          {% if block.settings.text_color != blank %}
            #shopidy-block-{{ block.id }}.multicolumn-card .multicolumn-card__heading, #shopidy-block-{{ block.id }}.multicolumn-card .multicolumn-card__text, #shopidy-block-{{ block.id }}.multicolumn-card .multicolumn-card__text p, #shopidy-block-{{ block.id }}.multicolumn-card .multicolumn-card__image-wrapper {
              color: {{ block.settings.text_color }};
            }
          {% endif %}
        {% endstyle %}
        <div id="shopidy-block-{{ block.id }}" class="multicolumn-card{% if block.settings.button_right %} multicolumn-card--button-right{% endif %}{% if section.settings.layout_style == "tertiary" %} tertiary_card{% endif %}" {{ block.shopify_attributes }}>
          <div class="multicolumn-card__content">
            {%- if block.settings.icon_pack != 'none' or block.settings.svg_icon != 'none' -%}
              <div
                      class="
                  multicolumn-card__image-wrapper multicolumn-card__image-wrapper--icon multicolumn-card__image-wrapper--{{- section.settings.icon_size }} {% if section.settings.box_shadow %}multicolumn-card__image-wrapper--shadow
                  {% endif %} multicolumn-card__image-wrapper--{{- section.settings.icon_style }} multicolumn-card__image-wrapper--{{- block.settings.icon_fill_type }} color-{{ block.settings.icon_color_scheme }}
                "
                {% if section.settings.icon_background != blank %}
                  style="background-color: {{ section.settings.icon_background }};border-radius: 1rem;"
                {% endif %}
              >
                {% style %}
                  {% if section.settings.icon_background_remove %}
                    #shopify-section-{{ section.id }} .multicolumn-card__image-wrapper--icon.multicolumn-card__image-wrapper--shadow {
                      box-shadow: 0 0 0 !important;
                      background-color: rgba(0, 0, 0, 0) !important;
                    }
                    @media (min-width: 990px) {
                      #shopify-section-{{ section.id }} .multicolumn-card, .multicolumn-card__content {
                          gap: 0.4rem !important;
                      }
                    }
                  {% endif %}
                {% endstyle %}
                {%
                  render "icon-selector",
                        icon_type:block.settings.icon_type,
                        icon_pack_icon: block.settings.icon_pack,
                        svg_icon: block.settings.svg_icon,
                        icon_pack_icon_style: section.settings.icon_style,
                        icon_pack_icon_fill_type: block.settings.icon_fill_type,
                        color:block.settings.icon_color,
                        width: block.settings.icon_size,
                        height: block.settings.icon_size
                %}
              </div>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <div style="width: 100% !important;" class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--image multicolumn-card__image-wrapper--{{ section.settings.image_width }} multicolumn-card__image-wrapper--{{ section.settings.image_ratio }}">
                {% liquid
                  assign aspect_ratio = block.settings.image.aspect_ratio
                  case section.settings.image_ratio
                    when 'portrait'
                      assign image_ratio = 1.4
                    when 'square'
                      assign image_ratio = 1
                    else
                      assign image_ratio = 0.5
                  endcase
                %}

                {% if aspect_ratio > image_ratio and block.settings.image.width > block.settings.image.height %}
                  {% case section.settings.multicolumn_to_show %}
                    {% when 4 %}
                      {% capture sizes %}
                        (min-width: 1360px) calc((100vw - 128px) / 4 * {{ aspect_ratio }} * {{ image_ratio }}), (min-width: 990px) calc((100vw - 40px) / 3 * {{ aspect_ratio }} * {{ image_ratio }}), (min-width: 576px) calc((100vw - 40px) / 2 * {{ aspect_ratio }} * {{ image_ratio }}), calc((100vw - 40px) * {{ aspect_ratio }} * {{ image_ratio }})
                      {% endcapture %}
                    {% when 3 %}
                      {% capture sizes %}
                        (min-width: 990px) calc((100vw - 40px) / 3 * {{ aspect_ratio }} * {{ image_ratio }}), (min-width: 576px) calc((100vw - 40px) / 2 * {{ aspect_ratio }} * {{ image_ratio }}), calc((100vw - 40px) * {{ aspect_ratio }} * {{ image_ratio }})
                      {% endcapture %}
                    {% when 2 %}
                      {% capture sizes %}
                        (min-width: 576px) calc((100vw - 40px) / 2 * {{ aspect_ratio }} * {{ image_ratio }}), calc((100vw - 40px) * {{ aspect_ratio }} * {{ image_ratio }})
                      {% endcapture %}
                    {% else %}
                      {% capture sizes %}
                        calc((100vw - 40px) * {{ aspect_ratio }} * {{ image_ratio }})
                      {% endcapture %}
                  {% endcase %}
                {% elsif aspect_ratio > image_ratio and block.settings.image.width < block.settings.image.height %}
                  {% case section.settings.multicolumn_to_show %}
                    {% when 4 %}
                      {% capture sizes %}
                        (min-width: 1360px) calc((100vw - 128px) / 4 / {{ aspect_ratio }}) * {{ image_ratio }}, (min-width: 990px) calc((100vw - 40px) / 3 / {{ aspect_ratio }} * {{ image_ratio }}), (min-width: 576px) calc((100vw - 40px) / 2 / {{ aspect_ratio }} * {{ image_ratio }}), calc((100vw - 40px) / {{ aspect_ratio }} * {{ image_ratio }})
                      {% endcapture %}
                    {% when 3 %}
                      {% capture sizes %}
                        (min-width: 990px) calc((100vw - 40px) / 3 / {{ aspect_ratio }} * {{ image_ratio }}), (min-width: 576px) calc((100vw - 40px) / 2 / {{ aspect_ratio }} * {{ image_ratio }}), calc((100vw - 40px) / {{ aspect_ratio }} * {{ image_ratio }})
                      {% endcapture %}
                    {% when 2 %}
                      {% capture sizes %}
                        (min-width: 576px) calc((100vw - 40px) / 2 / {{ aspect_ratio }} * {{ image_ratio }}), calc((100vw - 40px) / {{ aspect_ratio }} * {{ image_ratio }})
                      {% endcapture %}
                    {% else %}
                      {% capture sizes %}
                        calc((100vw - 40px) / {{ aspect_ratio }} * {{ image_ratio }})
                      {% endcapture %}
                  {% endcase %}
                {% else %}
                  {% case section.settings.multicolumn_to_show %}
                    {% when 4 %}
                      {% capture sizes %}
                        (min-width: 1360px) calc((100vw - 128px) / 4), (min-width: 990px) calc((100vw - 40px) / 3), (min-width: 576px) calc((100vw - 40px) / 2), calc((100vw - 40px))
                      {% endcapture %}
                    {% when 3 %}
                      {% capture sizes %}
                        (min-width: 990px) calc((100vw - 40px) / 3), (min-width: 576px) calc((100vw - 40px) / 2), calc((100vw - 40px))
                      {% endcapture %}
                    {% when 2 %}
                      {% capture sizes %}
                        (min-width: 576px) calc((100vw - 40px) / 2), calc((100vw - 40px))
                      {% endcapture %}
                    {% else %}
                      {% capture sizes %}
                        calc((100vw - 40px))
                      {% endcapture %}
                  {% endcase %}
                {% endif %}
                {% liquid
                  assign height = block.settings.image.height
                  assign width = block.settings.image.width
                %}
                {%- capture style -%}object-fit: {{ section.settings.object_fit }};{%- endcapture -%}
                {{
                block.settings.image
                | image_url: width: block.settings.image.width
                | image_tag:
                loading: '',
                sizes: sizes,
                widths: '360, 535, 600, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3200, 3400, 3600, 3800',
                height: height,
                width: width,
                style: style
                }}
              </div>
            {%- endif -%}


            <div class="multicolumn-card__info {% if section.settings.layout_style == "tertiary" %} tertiary_card_info {% endif %}">
              {% style %}
                #shopify-section-{{ section.id }} .multicolumn--solid .multicolumn-card__text {
                  max-width: 100% !important;
                }
                #shopify-section-{{ section.id }} .multicolumn--solid .multicolumn-card__heading {
                  max-width: 100% !important;
                }
              {% endstyle %}
              {%- if block.settings.heading != blank -%}
                <{{ block.settings.heading_tag }} class="multicolumn-card__heading {{ section.settings.card_heading_size }}">
                  {{ block.settings.heading | escape }}
                </{{ block.settings.heading_tag }}>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="multicolumn-card__text">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if block.settings.show_button != blank and section.settings.button_on_bottom != true and block.settings.button_right != true -%}
                {% render 'button',
              block_id: block.id,
              section_id: section.id,
                        link: block.settings.button_link,
                        label: block.settings.button_label,
                        style: block.settings.button_style,
                        class: 'multicolumn-card'
                %}
              {% endif %}
            </div>
          </div>

          {%- if block.settings.show_button != blank -%}
            {% if section.settings.button_on_bottom or block.settings.button_right %}
              <div class="multicolumn-card__button-wrapper">
                {% render 'button',
              block_id: block.id,
              section_id: section.id,
                        link: block.settings.button_link,
                        label: block.settings.button_label,
                        style: block.settings.button_style,
                        class: 'multicolumn-card'
                %}
              </div>
            {% endif %}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% if section.settings.full_width == false %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Multicolumn",
  "class": "spaced-section multicolumn-section copy-multicolumn",
  "tag": "section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "select",
      "id": "section_type",
      "options": [
        {
          "value": "solid",
          "label": "t:sections.multicolumn.settings.section_type.options__1.label"
        },
        {
          "value": "separators",
          "label": "t:sections.multicolumn.settings.section_type.options__2.label"
        },
        {
          "value": "transparent",
          "label": "t:sections.multicolumn.settings.section_type.options__4.label"
        }
      ],
      "default": "transparent",
      "label": "t:sections.multicolumn.settings.section_type.label"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.subheading_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.subheading_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "Tertiary"
        }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "content_alignment_horizontal",
      "label": "Align content horizontal",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "button_full_width",
      "label": "Button full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "button_on_bottom",
      "label": "Align button on bottom",
      "default": false
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon Position",
      "options": [
        { 
          "value": "column", 
          "label": "Above" 
        },
        { 
          "value": "row", 
          "label": "Beside" 
        }
      ],
      "default": "column"
    },
    {
      "type": "range",
      "id": "icon_padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 40,
      "unit": "px",
      "info": "Only applied when the content alignment is horizontal",
      "label": "Icon padding"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border",
      "label": "t:sections.all.enable_border.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_full",
      "label": "t:sections.all.border_full.label",
      "default": false
    },
    {
      "type": "range",
      "id": "multicolumn_to_show",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "t:sections.multicolumn.settings.multicolumn_to_show.label"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:sections.multicolumn.settings.gap.label",
      "info": "t:sections.multicolumn.settings.gap.info",
      "options": [
        {
          "value": "large",
          "label": "t:sections.multicolumn.settings.gap.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.multicolumn.settings.gap.options__2.label"
        },
        {
          "value": "small",
          "label": "t:sections.multicolumn.settings.gap.options__3.label"
        }
      ],
      "default": "large"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "select",
      "id": "subheading_tag",
      "label": "Subheading tag",
      "options": [
        { "value": "p", "label": "p" },
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" },
        { "value": "h5", "label": "h5" },
        { "value": "h6", "label": "h6" }
      ],
      "default": "p"
    },
    {
      "type": "select",
      "id": "subheading_style",
      "options": [
        {
          "value": "subtitle",
          "label": "t:sections.all.subheading_style.options__1.label"
        },
        {
          "value": "subtitle subtitle--secondary",
          "label": "t:sections.all.subheading_style.options__2.label"
        }
      ],
      "default": "subtitle",
      "label": "t:sections.all.subheading_style.label"
    },
    {
      "type": "select",
      "id": "subheading_icon_type",
      "label": "t:sections.all.subheading_icon.label",
