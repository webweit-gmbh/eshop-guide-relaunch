        "text_PPEMkm": {
          "type": "text",
          "settings": {
            "text": "<ol><li><a href=\"#1\" title=\"#1\">Wer ist AniForte?</a></li><li><a href=\"#2\" title=\"#2\">Von Strato, JTL, Afterbuy und Shopware zu Shopify Plus</a></li><li><a href=\"#3\" title=\"#3\">Performance-Probleme und Sicherheitslücken: Massive Schwierigkeiten mit Shopware</a></li><li><a href=\"#4\" title=\"#4\">Shopware 5 vs. Shopify Plus</a></li><li><a href=\"#5\" title=\"#5\">Die richtige Shopify Plus-Agentur finden</a></li><li><a href=\"#6\" title=\"#6\">50 % mehr Conversions und ein Umsatzplus von 15 %</a></li><li><a href=\"#7\" title=\"#7\">Wachstumssteigernde Shopify Plus Apps und Features</a></li><li><a href=\"#8\" title=\"#8\">Quo vadis, AniForte? - Pläne für die Unternehmenszukunft</a></li></ol>"
          }
        }
      },
      "block_order": [
