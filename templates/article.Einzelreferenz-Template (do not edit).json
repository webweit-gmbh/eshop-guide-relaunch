      }
    },
    "testimonials_xyVGhc": {
      "type": "testimonials",
      "blocks": {
        "testimonials_slide_pzdKbU": {
          "type": "testimonials_slide",
          "settings": {
            "enable_rating": false,
            "rating": 5,
            "enable_badge": false,
            "color_scheme_badge": "",
            "badge_text": "Shopify Migration",
            "slide_text": "„Außerdem  bietet Shopify ein stabiles Framework für Eigenentwicklungen. Wir haben  wirklich kompetente Mitarbeiter:innen mit verschiedenen Fachdisziplinen  im Haus – und diesen fällt die Arbeit natürlich wesentlich einfacher,  wenn es klare Rahmenbedingungen gibt und nicht jede einzelne  Schnittstelle von der Pike auf neu programmiert werden muss.“",
            "box_color": "#15c8e4",
            "slide_name": "Michael Höcker",
            "slide_position": "Head of E-Commerce & Marketing"
          }
