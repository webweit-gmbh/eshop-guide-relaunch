      "type": "testimonials",
      "blocks": {
        "testimonials_slide_jdngqY": {
          "type": "testimonials_slide",
          "settings": {
            "enable_rating": false,
            "rating": 5,
            "enable_badge": false,
            "color_scheme_badge": "",
            "badge_text": "Shopify Migration",
            "slide_text": "„Eigentlich  hatten wir uns gut vorbereitet, ein massives Lasten- und Pflichtenheft  angelegt, anderthalb Jahre Entwicklungszeit eingeplant. Dann kam der  Tag, an dem wir mit dem neuen Store live gingen und es funktionierte –  nichts.“",
            "image": "shopify://shop_images/33c9091cfc827f5aa3d32555b22c685d.png",
