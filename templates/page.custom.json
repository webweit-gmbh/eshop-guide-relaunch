            "svg_icon": "icon-EG-medal",
            "icon_color": "",
            "icon_color_scheme": "background-2",
            "icon_fill_type": "solid",
            "heading": "Mehr Erfahrung",
            "heading_tag": "h3",
            "text": "<p>Als andere noch mit WordPress durchs Netz gehumpelt sind, haben wir bereits Shopify Stores gebaut. Gesehen haben wir dabei inzwischen so ziemlich alles, deshalb haben wir auch keine Angst vor deiner Custom Solution.</p>",
            "text_color": "",
            "background_gradient": "linear-gradient(180deg, rgba(190, 253, 95, 1) 1%, rgba(190, 253, 95, 0.5) 90%)",
            "show_button": false,
            "button_right": false,
