    "testimonials_Hn69C6": {
      "type": "testimonials",
      "blocks": {
        "testimonials_slide_yMc9VC": {
          "type": "testimonials_slide",
          "settings": {
            "enable_rating": true,
            "rating": 5,
            "enable_badge": false,
            "color_scheme_badge": "background-3",
            "badge_text": "Shopify Migration",
            "slide_text": "“Es ist super, lexoffice direkt mit dem Shop zu verknüpfen. Meine Rechnungen werden automatisch erstellt und versendet. Als ich ein Problem mit dem Rechnungsversand hatte (der Fehler lag bei mir, die Domain der Versender-Email hatte sich geändert), wurde mir exzellent geholfen! Ich habe abends angefragt und direkt am nächsten Tag fand ich ein extra für mich aufgenommenes Erklärvideo vom Eshop Guide Support.”",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Link label",
            "button_link": "",
            "image": "shopify://shop_images/Lexware_Bewertung.png",
