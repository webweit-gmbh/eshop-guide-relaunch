    "custom_liquid_XWwDHt": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "anchor_id": "",
        "custom_liquid": "<style>\n.pricecards{display:flex;gap:25px;padding:0 80px 20px 80px}\n.pricecard{flex:1;border-radius:12px;padding:45px;position:relative;overflow:hidden;display:flex;flex-direction:column}\n.pricecard.blue{background:#D8F6FF}\n.pricecard.green{background:#DAFFC1}\n.badge{background:#BEFD5F;color:#00486f;font-size:11px;font-weight:700;letter-spacing:.05em;text-align:center;padding:6px;margin:-24px -24px 16px -24px;display:block}\n.badge-placeholder{display:block;height:29px;margin:-24px -24px 16px -24px}\n.plan-type{color:#00486f;font-size:11px;font-weight:700;letter-spacing:.05em;margin:0 0 4px}\n.pricecard h3{color:#00486f;font-size:28px;font-weight:700;margin:0 0 4px}\n.price-sub{color:#00486f;font-size:18px;font-weight:700; margin:0 0 4px}\n.divider{border:none;border-top:1px solid rgba(0,72,111,.2);margin:12px 0}\n.cancel{color:#00486f;font-size:16px;margin:0 0 16px}\n.pricebox{background:#fff;border-radius:8px;padding:12px 16px;color:#00486f;margin-top:auto}\n.pricebox-label{font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;margin:0 0 4px}\n.pricebox-amount{font-size:22px;font-weight:700;margin:0}\n</style>\n\n<div class=\"pricecards\">\n  <div class=\"pricecard blue\">\n    <span class=\"badge-placeholder\"></span>\n    <p class=\"plan-type\">MONATSPLAN</p>\n    <h3>Standard</h3>\n    <p class=\"price-sub\">11,49 € / Monat</p>\n    <hr class=\"divider\">\n    <p class=\"cancel\">Jederzeit kündbar</p>\n    <div class=\"pricebox\">\n      <p class=\"pricebox-label\">Einmalige Partnerprämie pro aktivierten Kunden</p>\n      <p class=\"pricebox-amount\">22,98 €</p>\n    </div>\n  </div>\n  <div class=\"pricecard blue\">\n    <span class=\"badge-placeholder\"></span>\n    <p class=\"plan-type\">MONATSPLAN</p>\n    <h3>Premium</h3>\n    <p class=\"price-sub\">22,99 € / Monat</p>\n    <hr class=\"divider\">\n    <p class=\"cancel\">Jederzeit kündbar</p>\n    <div class=\"pricebox\">\n      <p class=\"pricebox-label\">Einmalige Partnerprämie pro aktivierten Kunden</p>\n      <p class=\"pricebox-amount\">45,98 €</p>\n    </div>\n  </div>\n  <div class=\"pricecard green\">\n    <span class=\"badge\">BELIEBTESTER PLAN</span>\n    <p class=\"plan-type\">JAHRESPLAN</p>\n    <h3>Standard</h3>\n    <p class=\"price-sub\">120 € / Jahr</p>\n    <hr class=\"divider\">\n    <p class=\"cancel\">Jährlich kündbar</p>\n    <div class=\"pricebox\">\n      <p class=\"pricebox-label\">Einmalige Partnerprämie pro aktivierten Kunden</p>\n      <p class=\"pricebox-amount\">30,00 €</p>\n    </div>\n  </div>\n  <div class=\"pricecard green\">\n    <span class=\"badge\">HÖCHSTE PRÄMIE</span>\n    <p class=\"plan-type\">JAHRESPLAN</p>\n    <h3>Premium</h3>\n    <p class=\"price-sub\">240 € / Jahr</p>\n    <hr class=\"divider\">\n    <p class=\"cancel\">Jährlich kündbar</p>\n    <div class=\"pricebox\">\n      <p class=\"pricebox-label\">Einmalige Partnerprämie pro aktivierten Kunden</p>\n      <p class=\"pricebox-amount\">60,00 €</p>\n    </div>\n  </div>\n</div>"
