    "custom_liquid_fQtf3r": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "anchor_id": "",
        "custom_liquid": "<style>\nhtml {\n  scroll-behavior: smooth;\n}\n\n.eg-webinar-form-wrapper {\n  max-width: 760px;\n  margin: 0 auto;\n  padding: 36px;\n  background: #ffffff;\n  border: 1px solid #e6eaf0;\n  border-radius: 20px;\n  box-shadow: 0 10px 30px rgba(15,23,42,0.06);\n}\n\n.eg-webinar-form-title {\n  margin: 0 0 10px;\n  font-size: 34px;\n  line-height: 1.1;\n  font-weight: 700;\n  color: #00486f;\n}\n\n.eg-webinar-form-subtitle {\n  margin: 0 0 24px;\n  font-size: 16px;\n  line-height: 1.6;\n  color: #475569;\n}\n\n.eg-mailchimp-form {\n  display: grid;\n  gap: 18px;\n}\n\n.eg-form-row {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16px;\n}\n\n.eg-form-field {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n}\n\n.eg-form-field label {\n  font-size: 14px;\n  font-weight: 600;\n  color: #00486f;\n}\n\n.eg-form-field input {\n  width: 100%;\n  min-height: 54px;\n  padding: 0 16px;\n  border: 1px solid #d8dee8;\n  border-radius: 12px;\n  background: #ffffff;\n  font-size: 16px;\n  color: #00486f;\n  box-sizing: border-box;\n  transition: border-color 0.2s ease, box-shadow 0.2s ease;\n}\n\n.eg-form-field input::placeholder {\n  color: #94a3b8;\n}\n\n.eg-form-field input:focus {\n  outline: none;\n  border-color: #00486f;\n  box-shadow: 0 0 0 3px rgba(0,72,111,0.15);\n}\n\n.eg-required {\n  color: #c2410c;\n}\n\n.eg-form-meta {\n  font-size: 13px;\n  color: #64748b;\n  margin-top: -6px;\n}\n\n.eg-form-submit {\n  margin-top: 8px;\n}\n\n.eg-submit-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 54px;\n  padding: 0 24px;\n  border: none;\n  border-radius: 12px;\n  background: #00486f;\n  color: #ffffff;\n  font-size: 16px;\n  font-weight: 700;\n  cursor: pointer;\n  transition: transform 0.15s ease, opacity 0.2s ease;\n}\n\n.eg-submit-button:hover {\n  opacity: 0.95;\n  transform: translateY(-1px);\n}\n\n.eg-privacy-note {\n  margin: 10px 0 0;\n  font-size: 13px;\n  line-height: 1.5;\n  color: #64748b;\n}\n\n.eg-hidden-field {\n  position: absolute;\n  left: -5000px;\n}\n\n.eg-hidden-iframe {\n  display:none;\n}\n\n@media (max-width: 749px) {\n  .eg-webinar-form-wrapper {\n    padding: 24px;\n    border-radius: 16px;\n  }\n\n  .eg-webinar-form-title {\n    font-size: 28px;\n  }\n\n  .eg-form-row {\n    grid-template-columns: 1fr;\n  }\n}\n</style>\n\n\n<div id=\"webinar-form\" class=\"eg-webinar-form-wrapper\">\n\n<h2 class=\"eg-webinar-form-title\">\nOn-Demand Webinar ansehen\n</h2>\n\n<p class=\"eg-webinar-form-subtitle\">\nFülle das Formular aus und erhalte die Webinar-Aufzeichnung direkt per E-Mail.\n</p>\n\n\n<form\naction=\"https://eshop-guide.us11.list-manage.com/subscribe/post?u=ed2349c4878dab1c69678f8b4&amp;id=5308731073&amp;f_id=007d15e1f0\"\nmethod=\"post\"\ntarget=\"hidden_iframe_webinar\"\nclass=\"eg-mailchimp-form\"\nid=\"eg-mailchimp-form\"\n>\n\n<div class=\"eg-form-meta\">\n<span class=\"eg-required\">*</span> Pflichtfeld\n</div>\n\n\n<div class=\"eg-form-field\">\n<label for=\"mce-EMAIL\">\nE-Mail-Adresse <span class=\"eg-required\">*</span>\n</label>\n\n<input\ntype=\"email\"\nname=\"EMAIL\"\nid=\"mce-EMAIL\"\nplaceholder=\"name@unternehmen.de\"\nrequired\n>\n</div>\n\n\n<div class=\"eg-form-row\">\n\n<div class=\"eg-form-field\">\n<label for=\"mce-FNAME\">\nVorname <span class=\"eg-required\">*</span>\n</label>\n\n<input\ntype=\"text\"\nname=\"FNAME\"\nid=\"mce-FNAME\"\nplaceholder=\"Dein Vorname\"\nrequired\n>\n</div>\n\n\n<div class=\"eg-form-field\">\n<label for=\"mce-LNAME\">\nNachname <span class=\"eg-required\">*</span>\n</label>\n\n<input\ntype=\"text\"\nname=\"LNAME\"\nid=\"mce-LNAME\"\nplaceholder=\"Dein Nachname\"\nrequired\n>\n</div>\n\n</div>\n\n\n<div class=\"eg-form-field\">\n<label for=\"mce-MMERGE5\">\nFirmenname <span class=\"eg-required\">*</span>\n</label>\n\n<input\ntype=\"text\"\nname=\"MMERGE5\"\nid=\"mce-MMERGE5\"\nplaceholder=\"Name deines Unternehmens\"\nrequired\n>\n</div>\n\n\n<div class=\"eg-form-row\">\n\n<div class=\"eg-form-field\">\n<label for=\"mce-MMERGE6\">\nJobtitel <span class=\"eg-required\">*</span>\n</label>\n\n<input\ntype=\"text\"\nname=\"MMERGE6\"\nid=\"mce-MMERGE6\"\nplaceholder=\"z. B. Head of E-Commerce\"\nrequired\n>\n</div>\n\n\n<div class=\"eg-form-field\">\n<label for=\"mce-MMERGE7\">\nLand <span class=\"eg-required\">*</span>\n</label>\n\n<input\ntype=\"text\"\nname=\"MMERGE7\"\nid=\"mce-MMERGE7\"\nplaceholder=\"z. B. Deutschland\"\nrequired\n>\n</div>\n\n</div>\n\n\n<input type=\"hidden\" name=\"tags\" value=\"9327779\">\n\n\n<div class=\"eg-hidden-field\">\n<input\ntype=\"text\"\nname=\"b_ed2349c4878dab1c69678f8b4_5308731073\"\ntabindex=\"-1\"\nvalue=\"\"\n>\n</div>\n\n\n<div class=\"eg-form-submit\">\n\n<input\ntype=\"submit\"\nname=\"subscribe\"\nvalue=\"Link per E-Mail erhalten\"\nclass=\"eg-submit-button\"\n>\n\n</div>\n\n\n<p class=\"eg-privacy-note\">\nMit dem Absenden des Formulars erklärst du dich damit einverstanden, dass wir deine Angaben zur Bereitstellung der Webinar-Aufzeichnung verarbeiten.\n</p>\n\n</form>\n\n\n<iframe\nname=\"hidden_iframe_webinar\"\nid=\"hidden_iframe_webinar\"\nclass=\"eg-hidden-iframe\"\n></iframe>\n\n</div>\n\n\n<script>\n(function() {\n\nvar iframe = document.getElementById(\"hidden_iframe_webinar\");\n\nif (!iframe) return;\n\niframe.addEventListener(\"load\", function() {\n\nwindow.location.href = \"https://www.eshop-guide.de/pages/webinar-danke\";\n\n});\n\n})();\n</script>"
      }
