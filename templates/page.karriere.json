          "type": "step",
          "settings": {
            "image_width": 500,
            "number": "Hallo sagen",
            "heading": "Zeig uns, wer du bist",
            "heading_tag": "h3",
            "text": "Schick uns deinen Lebenslauf – keine seitenlangen Anschreiben nötig. Uns interessiert, was dich begeistert und warum du zu uns passt. Nach deiner Bewerbung bekommst du innerhalb weniger Tage eine Rückmeldung.",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Know More",
            "button_link": ""
          }
        },
        "step_n9jmLe": {
          "type": "step",
          "settings": {
            "image_width": 500,
            "number": "Kennenlernen",
            "heading": "Zeig uns, was du kannst",
            "heading_tag": "h3",
            "text": "Im Erstgespräch lernst du unsere HR-Managerin kennen. Wir sprechen über deinen Werdegang, deine Wünsche und unsere Werte – ganz entspannt und auf Augenhöhe. Wenn alles passt, geht’s weiter mit einem fachlichen Interview und einer kleinen Case Study.",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Know More",
            "button_link": ""
          }
        },
        "step_tC4P6z": {
          "type": "step",
          "settings": {
            "image_width": 500,
            "number": "Willkommen an Bord",
            "heading": "Wir zeigen dir dein Zimmer",
            "heading_tag": "h3",
            "text": "Nach deiner Präsentation der Case Study lernst du dein Team kennen und wir klären die letzten Details. Passt es für beide Seiten? Dann bekommst du dein Angebot und deinen Platz in deinem neuen Zuhause.",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Know More",
            "button_link": ""
          }
        }
      },
