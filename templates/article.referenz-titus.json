        "testimonials_slide_bD8Dq4": {
          "type": "testimonials_slide",
          "settings": {
            "enable_rating": false,
            "rating": 5,
            "enable_badge": false,
            "color_scheme_badge": "",
            "badge_text": "Shopify Migration",
            "slide_text": "„Skateboarding ist vielfältig und immer in der Entwicklung. Der Style ändert sich, die Art, wie geskatet wird, ändert sich. Genauso ist es im Unternehmertum und mit dem, was wir bei TITUS machen: Wir befinden uns in einer konstanten Entwicklung. Unser Backlog ist ordentlich mit Ideen gefüllt - stay tuned.\nSucht nach Menschen, die euch dabei unterstützen, aus eurem Traum Realität zu machen.\nAllen anderen Händlerinnen und Händlern möchte ich außerdem Folgendes raten: Egal wie groß der Haufen Scheiße vor dir auch sein mag - KEEP PUSHING. Und sucht nach Menschen, die euch dabei unterstützen, aus eurem Traum Realität zu machen.”",
            "show_button": false,
