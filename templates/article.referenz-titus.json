    "testimonials_MzzHLi": {
      "type": "testimonials",
      "blocks": {
        "testimonials_slide_kYqpM3": {
          "type": "testimonials_slide",
          "settings": {
            "enable_rating": false,
            "rating": 5,
            "enable_badge": false,
            "color_scheme_badge": "",
            "badge_text": "Shopify Migration",
            "slide_text": "„Bei  TITUS setzen wir Projekte als agile Sprints um. Eshop Guide verwendet  genau dieselbe Methode. Deshalb ging die Umsetzung nicht nur reibungslos  über die Bühne, sondern auch in Rekordzeit. Dank agiler Sprints konnten wir den Launch dreimal vorziehen.”",
