    "rich_text_pXHbqD": {
      "type": "rich-text",
      "blocks": {
        "text_nRDpgb": {
          "type": "text",
          "settings": {
            "text": "<p>Allerdings sind verbesserte Performance und ein störungsfreies Einkaufserlebnis nur ein Teil dessen, was wir gemeinsam mit TITUS realisieren konnten. Denn da wären außerdem:</p>"
          }
        }
      },
      "block_order": [
        "text_nRDpgb"
      ],
      "settings": {
        "anchor_id": "",
