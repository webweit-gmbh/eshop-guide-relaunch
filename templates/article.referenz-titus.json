        "icon_color": "",
        "enable_scribble": true,
        "scribble_style": "circle1",
        "scribble_stroke_width": 13,
        "scribble_color": "#f2e6ff",
        "scribble_size": 108,
        "scribble_top": 50,
        "heading": "Von Shopware zu Shopify Plus: Umsetzung im #scribble-start#Sprint#scribble-end#",
        "heading_tag": "h2",
        "heading_size": "h2",
        "heading_line": "simple",
        "line_color": "#1566e0",
        "word_break": false,
        "heading_animation": "none",
        "word_break_an": false,
        "text": "Die Anforderungen der Stakeholder waren also klar und priorisiert, TITUS und Eshop Guide befanden sich in den Startlöchern. Und dann? Ging alles sehr schnell, denn Michael erklärt:",
        "text_align": "left",
        "slide_color_scheme": "scheme-68a3d7e4-6a10-44cb-b105-f20261e20a87",
        "slide_text_size": "h6",
        "enable_navigation": false,
        "enable_navigation_mobile": false,
        "navigation_color_scheme": "",
        "enable_pagination": false,
        "enable_pagination_mobile": true,
        "pagination_color_scheme": "",
