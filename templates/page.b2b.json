            "svg_icon": "none",
            "icon_size": 30,
            "icon_color": "",
            "icon_color_scheme": "background-1",
            "icon_fill_type": "gradient",
            "heading": "Integration von ERP- und CRM-Systemen",
            "heading_tag": "h3",
            "text": "<p>Wer groß handelt, schiebt seine Daten nicht in Excel-Tabellen hin und her, sondern nutzt professionelle Software. Wenn die nicht mit dem Shop kommunizieren kann, ist das sofort ein K.-o.-Kriterium.</p>",
            "text_color": "",
            "background_gradient": "",
            "show_button": false,
            "button_right": false,
            "button_label": "Label",
            "button_link": "",
            "button_style": "simple"
