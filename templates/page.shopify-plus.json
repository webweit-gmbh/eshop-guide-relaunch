    "case_studies_6WkMhd": {
      "type": "case-studies",
      "blocks": {
        "case_slide_qaTHpU": {
          "type": "case_slide",
          "settings": {
            "image": "shopify://shop_images/33c9091cfc827f5aa3d32555b22c685d.png",
            "image_column_width": 35,
            "overlay_color": "#000000",
            "overlay_opacity": 0,
            "image_in_front_of_overlay": false,
            "heading": "",
            "heading_tag": "p",
            "text": "",
            "quote": "„Hätte ich gewusst, wie einfach Internationalisierung mit Shopify Plus geht, wir hätten schon vor Jahren gewechselt.”",
            "quote_size": "recommended",
            "author_image": "shopify://shop_images/TITUS_Hexagon_V2a_Black_4c_RGB_1000x805px_cc39c7bb-d82f-45fa-8451-4a4b24e6a6f0.png",
            "author_name": "Julius Dittmann",
            "author_position": "CEO, TITUS",
            "show_button": true,
            "button_style": "simple",
            "button_label": "Zur ganzen Story",
            "button_link": "shopify://blogs/referenzen/titus-wechsel-zu-shopify",
            "logo_width": 130
          }
        },
        "case_slide_Umx3Hk": {
          "type": "case_slide",
          "settings": {
            "image": "shopify://shop_images/Maik_Fabri_Aniforte.png",
            "image_column_width": 35,
            "overlay_color": "#000000",
            "overlay_opacity": 0,
            "image_in_front_of_overlay": true,
            "heading": "",
            "heading_tag": "p",
            "text": "",
            "quote": "„Mit dem Wechsel zu Shopify Plus hat sich unser Page Speed deutlich verbessert. Alle Seiten laden jetzt blitzschnell; es ist einfach kein Vergleich zu unserem alten Shop. Die Conversion Rate ist jetzt um 50 Prozent höher.“",
            "quote_size": "recommended",
            "author_image": "shopify://shop_images/AniForte_grey_250d86ed-a75c-42d2-ade3-abc5df6da48e.png",
            "author_name": "Maik Fabry",
            "author_position": "Head of E-Commerce, AniForte",
            "show_button": true,
            "button_style": "simple",
            "button_label": "Zur Referenz",
            "button_link": "shopify://blogs/referenzen/aniforte-wechsel-shopify-plus",
            "logo_width": 130
          }
        },
        "case_slide_8eHBx9": {
          "type": "case_slide",
          "settings": {
            "image": "shopify://shop_images/Katharina.jpg",
            "image_column_width": 35,
            "overlay_color": "#000000",
            "overlay_opacity": 0,
            "image_in_front_of_overlay": false,
            "heading": "",
            "heading_tag": "p",
            "text": "",
            "quote": "„Das Hauptargument für Shopify Plus war für mich die Skalierbarkeit, sowohl in Bezug auf den Traffic als auch auf den Produktanspruch. Wir rechnen weiterhin mit starkem Wachstum im B2C-Segment, da muss das Shopsystem nach vorn einfach offen sein.“",
