    "steps_KgLJLB": {
      "type": "steps",
      "blocks": {
        "step_bMAKpc": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/2015_Patrick.jpg",
            "image_width": 500,
            "number": "2015",
            "heading": "Jedem Anfang wohnt ein Lehrgeld inne",
            "heading_tag": "h3",
            "text": "Oliver und Patrick versuchen sich als Freelancer an ihrem ersten Onlineshop. Das Ergebnis ist zwar kein Glanzstück, für die zwei aber tatsächlich der erste Kontakt mit Shopify. Daraus könnte mehr werden …",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Know More",
            "button_link": ""
          }
        },
        "step_F7RWa9": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/2016_Eshop_Guide.jpg",
            "image_width": 500,
            "number": "2016",
            "heading": "Rule of Three",
            "heading_tag": "h3",
            "text": "Mit jedem neuen Shop werden die Ergebnisse besser. Als Dave als dritter Mann dazu stößt, steigt die Expertise sprunghaft an. Sein Gesellenstück: Eine App, die heute immer noch in den Tiefen des Shopify App Stores zu finden ist.",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Know More",
            "button_link": ""
          }
        },
        "step_ehhfTL": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/2016_Meetup.jpg",
            "image_width": 500,
            "number": "November 2016",
            "heading": "Shopify in Deutschland",
            "heading_tag": "h3",
            "text": "Erstes Shopify Meetup in Deutschland. Die Software kennt damals zwar kaum jemand, Patrick, Oliver und Dave allerdings machen sich in der Community schnell einen Namen – unter anderem, weil sie maßgeblich dazu beitragen, dass Shopify auch in der Bundesrepublik zum Begriff wird.",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Know More",
            "button_link": ""
          }
        },
        "step_wtJfWj": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/2017_Eshop_Guide.jpg",
            "image_width": 500,
            "number": "2017",
            "heading": "Sag Hallo zum ersten Gamechanger",
            "heading_tag": "h3",
            "text": "Mit der Erfindung des Setup-Pakets wird Eshop Guide richtig professionell. Das standardisierte Angebot macht es sowohl Start-ups als auch etablierten Unternehmen möglich, schnell und unkompliziert in den E-Commerce zu starten.",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Know More",
            "button_link": ""
          }
        },
        "step_7UKM86": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/2017_Team_wird_groesser_2.jpg",
            "image_width": 500,
            "number": "2018",
            "heading": "Wie, wir brauchen eine Personalabteilung?",
            "heading_tag": "h3",
            "text": "Zum wachsenden Erfolg gehört immer auch mehr Arbeit. Zunächst funktioniert das noch mit weiteren Freelancern, aber schnell wird klar: Angestellte wären besser. Alex und Lea unterschreiben als Erste ihren Arbeitsvertrag und sind immer noch mit dabei.",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Know More",
            "button_link": ""
          }
        },
        "step_EnxUEP": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/Meetup.png",
            "image_width": 500,
            "number": "2019",
            "heading": "Voll knorke hier",
            "heading_tag": "h3",
            "text": "Zwar ist es nirgends so schön wie im Ruhrgebiet, aber neue Standorte sollte man bekanntlich weiter weg eröffnen. Zunächst in Hannover, dann folgt mit Berlin sogar die Hauptstadt. Gerüchteweise soll dort mal eine Dame im Blazer und mit Handraute nach einem Shop gefragt haben.",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Know More",
            "button_link": ""
          }
        },
        "step_pJcgmp": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/Logo_Kunden.jpg",
            "image_width": 500,
            "number": "2020",
            "heading": "Allen wollen digital",
            "heading_tag": "h3",
            "text": "Durch die Pandemie wird der Leidensdruck für viele Unternehmen groß, eine Online-Präsenz zu eröffnen. Das inzwischen 30-Frau-und-Mann-Unternehmen empfängt sie mit offenen Armen und katapultiert sich damit in die Ränge der Großen.",
            "show_button": true,
            "button_style": "simple",
            "button_label": "",
            "button_link": ""
          }
        },
        "step_4XBCqD": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/Rebranding_Eshop_Guide.jpg",
            "image_width": 500,
            "number": "2024",
            "heading": "Rebranding, Rethinking, Returning",
            "heading_tag": "h3",
            "text": "Wer wächst, verliert auch immer etwas auf dem Weg. Nach einigen Jahren voller Arbeit und des Funktionierens besinnt sich Eshop Guide auf das, was wirklich wichtig ist: die Menschen im Unternehmen. Mit neuer Sprache nach innen und außen wird allen klar: Wir sind gekommen, um zu bleiben.",
            "show_button": true,
            "button_style": "simple",
            "button_label": "",
            "button_link": ""
          }
        },
        "step_4njCjx": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/Teamfoto_-_Eshop_Guide.jpg",
            "image_width": 500,
            "number": "2025",
            "heading": "Die aktuelle Lage",
            "heading_tag": "h3",
            "text": "Inzwischen gehören rund 50 Köpfe zu den Eshop Guides. Sie alle sind Spezialsit:innen für jede Facette des Onlinehandels: B2B und International, Apps, UX und UI. Über 700 Projekte sind in 10 Jahren erfolgreich abgeschlossen worden, darunter große Brands wie Vorwerk, Giesswein oder Titus.\nTrotz aller Professionalität: Verbogen hat sich die Agentur trotzdem nie. Ihre Kernwerte heißen weiterhin absolute Zuverlässigkeit, unverstellte Kommunikation und Lust auf Neues.",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Know More",
            "button_link": ""
          }
        }
      },
