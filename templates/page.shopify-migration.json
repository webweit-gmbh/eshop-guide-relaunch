        "case_slide_qaTHpU": {
          "type": "case_slide",
          "settings": {
            "image": "shopify://shop_images/Titus_Macbook_Mockup.png",
            "image_column_width": 45,
            "overlay_color": "#000000",
            "overlay_opacity": 0,
            "image_in_front_of_overlay": false,
            "heading": "",
            "heading_tag": "p",
            "text": "",
            "quote": "„Unsere Migration zu Shopify zusammen mit Eshop Guide haben wir gestartet, während zwei andere Großprojekte in unserem Unternehmen liefen. Deswegen sind wir eigentlich davon ausgegangen: Das wird sich hinziehen. Aber die Zusammenarbeit war so effizient, dass wir den Termin für den Launch dreimal vorziehen konnten.”",
            "quote_size": "h4",
            "author_image": "shopify://shop_images/TITUS_Hexagon_V2a_Black_4c_RGB_1000x805px_cc39c7bb-d82f-45fa-8451-4a4b24e6a6f0.png",
            "author_name": "Michael Höcker",
            "author_position": "Leitung Marketing und Onlineshop, TITUS",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Link label",
            "button_link": "",
            "logo_width": 130
          }
        },
        "case_slide_8eHBx9": {
          "type": "case_slide",
          "settings": {
            "image": "shopify://shop_images/LC_Produktseite.png",
            "image_column_width": 35,
            "overlay_color": "#000000",
            "overlay_opacity": 0,
            "image_in_front_of_overlay": false,
            "heading": "",
            "heading_tag": "p",
            "text": "",
            "quote": "„Am Anfang war ich ein wenig überrascht davon, wie schlank das Projektmanagement bei Eshop Guide gehalten wurde. Wir hatten zweimal in der Woche ein Meeting, bei dem wir uns in großer Runde abgestimmt haben. Einzelgespräche zu konkreten Fragen waren zwischendrin zu so gut wie jederzeit möglich. So gab es keine Hänger und keine Wartezeiten bei akuten Problemen. Vom Kick-off bis zum Live-Gang unseres neuen Shops dauerte es nur vier Monate. Das ist beeindruckend schnell.“",
            "quote_size": "h4",
            "author_image": "shopify://shop_images/Luisa_Cerano_Logo_05bb52ed-1e14-4aec-972e-5d8db8ef857b.png",
