          }
        },
        "richtext_group_ektUbT": {
          "type": "richtext-group",
          "settings": {
            "anchor_id": "",
            "color_scheme": "background-1",
            "full_width": true,
            "full_width_text": true,
            "columns": "multi",
            "alignment": "left",
            "margin_top": "no-indent",
