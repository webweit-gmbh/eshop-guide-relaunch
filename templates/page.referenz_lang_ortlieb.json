            "subheading_order": "01",
            "heading": "",
            "heading_tag": "h2",
            "heading_size": "medium",
            "heading_placement": "full",
            "heading_order": "02",
            "combo_1_heading": "",
            "combo_1_heading_tag": "h5",
            "combo_1_text": "<h5>Wie lange hat die Migration gedauert?</h5>",
            "combo_1_placement": "left",
            "combo_1_order": "10",
            "combo_2_heading": "",
            "combo_2_heading_tag": "h5",
            "combo_2_text": "",
