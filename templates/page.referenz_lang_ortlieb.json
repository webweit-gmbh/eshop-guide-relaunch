    "combined_rich_text_TV4KPC": {
      "type": "combined-rich-text",
      "blocks": {
        "richtext_group_bKNpKV": {
          "type": "richtext-group",
          "settings": {
            "anchor_id": "",
            "color_scheme": "background-1",
            "full_width": true,
            "full_width_text": true,
            "columns": "multi",
            "alignment": "left",
            "margin_top": "no-indent",
            "margin_bottom": "no-indent",
            "padding_top": "no-indent",
            "padding_bottom": "no-indent",
            "subheading": "",
            "subheading_tag": "p",
            "subheading_placement": "full",
            "subheading_order": "01",
            "heading": "",
            "heading_tag": "h2",
            "heading_size": "medium",
            "heading_placement": "full",
            "heading_order": "02",
            "combo_1_heading": "",
            "combo_1_heading_tag": "h5",
            "combo_1_text": "<h5>ORTLIEB und der Connected Commerce: Da geht noch was</h5>",
            "combo_1_placement": "left",
            "combo_1_order": "10",
            "combo_2_heading": "",
            "combo_2_heading_tag": "h5",
            "combo_2_text": "",
            "combo_2_placement": "left",
            "combo_2_order": "20",
            "combo_3_heading": "",
            "combo_3_heading_tag": "h5",
            "combo_3_text": "",
            "combo_3_placement": "left",
            "combo_3_order": "30",
            "combo_4_heading": "",
            "combo_4_heading_tag": "h5",
            "combo_4_text": "",
            "combo_4_placement": "left",
