            "combo_4_text": "",
            "combo_4_placement": "left",
            "combo_4_order": "40",
            "button_label": "",
            "button_link": "",
            "button_style": "primary",
            "button_placement": "left",
            "button_order": "40",
            "highlight_text": "<p><strong>Lesetipp</strong>:  <a href=\"/pages/agb\" title=\"Allgemeine Geschäftsbedingungen der Eshop Guide GmbH\">Und welches ERP willst du in Shopify integrieren? SAP? Xentral? Oder doch lieber MS Business Central?</a></p>",
