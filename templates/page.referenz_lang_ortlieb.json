        "richtext_group_kpdwQj": {
          "type": "richtext-group",
          "settings": {
            "anchor_id": "",
            "color_scheme": "scheme-6251fb50-60ea-49fc-8946-e4530a44657b",
            "full_width": true,
            "full_width_text": true,
            "columns": "multi",
