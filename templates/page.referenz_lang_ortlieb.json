            "subheading": "",
            "subheading_tag": "p",
            "subheading_placement": "full",
            "subheading_order": "01",
            "heading": "",
            "heading_tag": "h2",
            "heading_size": "medium",
            "heading_placement": "full",
            "heading_order": "02",
            "combo_1_heading": "",
            "combo_1_heading_tag": "h5",
            "combo_1_text": "<h5>Die Rechtevergabe</h5>",
            "combo_1_placement": "left",
            "combo_1_order": "10",
            "combo_2_heading": "",
            "combo_2_heading_tag": "h5",
            "combo_2_text": "<p><br/><br/></p>",
            "combo_2_placement": "right",
            "combo_2_order": "20",
            "combo_3_heading": "",
            "combo_3_heading_tag": "h5",
            "combo_3_text": "",
