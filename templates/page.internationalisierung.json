            "padding_bottom": "m",
            "icon": "none",
            "icon_size": 60,
            "heading": "<strong>Expert:innen & Wissenstransfer: Erfahrung, die deinen Shop weiterbringt</strong>",
            "heading_tag": "h3",
            "heading_size": "h3",
            "heading_line": "simple",
