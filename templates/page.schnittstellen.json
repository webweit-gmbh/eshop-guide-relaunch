    "testimonials_xTNVdy": {
      "type": "testimonials",
      "blocks": {
        "testimonials_slide_PcJtnw": {
          "type": "testimonials_slide",
          "settings": {
            "enable_rating": true,
            "rating": 5,
            "enable_badge": false,
            "color_scheme_badge": "scheme-5d73faf6-1389-497c-bf99-536a51029f18",
            "badge_text": "Shopify Migration",
            "slide_text": "\"Ganz tolles Team! Wir haben es mithilfe von Eshop-Guide binnen 2 Monaten geschafft, unsere beiden Shops komplett zu relaunchen. Eine sehr große Hilfe dabei war die sehr ergebnisorientierte und zielführende Arbeitsweise, insbesondere auch in Zusammenarbeit mit anderen Dienstleistern und Agenturen. Zusätzlich hat Eshop Guide innerhalb von nicht einmal 10 Tagen eine komplette API-Anbindung an unser ERP und Amazon auf die Beine gestellt, die fehlerfrei funktioniert. Kann man vollumfänglich weiterempfehlen!\"",
            "show_button": false,
            "button_style": "simple",
            "button_label": "Link label",
            "button_link": "",
            "logo_image": "shopify://shop_images/3_Petromax_Logo_Shopify_Plus.png",
