        "text_PPEMkm": {
          "type": "text",
          "settings": {
            "text": "<ol><li><a href=\"#1\" title=\"#1\">Nicht für Pantoffelhelden: Das ist GIESSWEIN</a></li><li><a href=\"#2\" title=\"#2\">Fit wie ein Merinoturnschuh: Neue Features im GIESSWEIN-Shop</a></li><li><a href=\"#3\" title=\"#3\">#1 Siebenstelliger Umsatz mit Post-Purchase Cross Sells auf der Thank-You-Seite</a></li><li><a href=\"#4\" title=\"#4\">#2 Entlastung des Supports durch Packstation-App</a></li><li><a href=\"#5\" title=\"#5\">#3 Pagespeed vielfach gesteigert</a></li><li><a href=\"#6\" title=\"#6\">#4 Die Macht der richtigen Worte</a></li><li><a href=\"#7\" title=\"#7\">Umsatzwachstum durch kontinuierliche Optimierung</a></li><li><a href=\"#8\" title=\"#8\">So geht es weiter bei GIESSWEIN</a></li></ol>"
          }
        }
      },
      "block_order": [
        "heading_dRJ4qd",
        "text_PPEMkm"
      ],
      "settings": {
