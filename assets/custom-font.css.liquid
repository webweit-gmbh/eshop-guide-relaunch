/* Instrument Sans Font Declarations */

/* Instrument Sans Regular */
@font-face {
  font-family: 'Instrument Sans';
  src: url('{{ "InstrumentSans-Regular.woff" | asset_url }}') format('woff');
  font-weight: 400;
  font-style: normal;
}

/* Instrument Sans Italic */
@font-face {
  font-family: 'Instrument Sans';
  src: url('{{ "InstrumentSans-Italic.woff" | asset_url }}') format('woff');
  font-weight: 400;
  font-style: italic;
}

/* Instrument Sans Medium */
@font-face {
  font-family: 'Instrument Sans';
  src: url('{{ "InstrumentSans-Medium.woff" | asset_url }}') format('woff');
  font-weight: 500;
  font-style: normal;
}

/* Instrument Sans Medium Italic */
@font-face {
  font-family: 'Instrument Sans';
  src: url('{{ "InstrumentSans-MediumItalic.woff" | asset_url }}') format('woff');
  font-weight: 500;
  font-style: italic;
}

/* Instrument Sans SemiBold */
@font-face {
  font-family: 'Instrument Sans';
  src: url('{{ "InstrumentSans-SemiBold.woff" | asset_url }}') format('woff');
  font-weight: 600;
  font-style: normal;
}

/* Instrument Sans SemiBold Italic */
@font-face {
  font-family: 'Instrument Sans';
  src: url('{{ "InstrumentSans-SemiBoldItalic.woff" | asset_url }}') format('woff');
  font-weight: 600;
  font-style: italic;
}

/* Instrument Sans Bold */
@font-face {
  font-family: 'Instrument Sans';
  src: url('{{ "InstrumentSans-Bold.woff" | asset_url }}') format('woff');
  font-weight: 700;
  font-style: normal;
}

/* Instrument Sans Bold Italic */
@font-face {
  font-family: 'Instrument Sans';
  src: url('{{ "InstrumentSans-BoldItalic.woff" | asset_url }}') format('woff');
  font-weight: 700;
  font-style: italic;
}

/* Apply Instrument Sans to the body */
body {
  font-family: 'Instrument Sans', sans-serif;
  font-weight: 400;
  font-style: normal;
}